<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 600 600" width="100%" height="100%">
  <defs>
    <linearGradient id="bg-Back View" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#0f172a"/>
      <stop offset="100%" stop-color="#1e293b"/>
    </linearGradient>
    <linearGradient id="screen-Back View" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#38bdf8"/>
      <stop offset="100%" stop-color="#2563eb"/>
    </linearGradient>
    <filter id="glow" x="-20%" y="-20%" width="140%" height="140%">
      <feDropShadow dx="0" dy="10" stdDeviation="15" flood-color="#0284c7" flood-opacity="0.3"/>
    </filter>
  </defs>
  <rect width="600" height="600" rx="24" fill="url(#bg-Back View)"/>
  
  <!-- Subtle Grid pattern -->
  <g opacity="0.07" stroke="#ffffff" stroke-width="1">
    <line x1="50" y1="0" x2="50" y2="600" />
    <line x1="150" y1="0" x2="150" y2="600" />
    <line x1="250" y1="0" x2="250" y2="600" />
    <line x1="350" y1="0" x2="350" y2="600" />
    <line x1="450" y1="0" x2="450" y2="600" />
    <line x1="550" y1="0" x2="550" y2="600" />
    <line x1="0" y1="100" x2="600" y2="100" />
    <line x1="0" y1="200" x2="600" y2="200" />
    <line x1="0" y1="300" x2="600" y2="300" />
    <line x1="0" y1="400" x2="600" y2="400" />
    <line x1="0" y1="500" x2="600" y2="500" />
  </g>

  <!-- Product Body Graphic -->
  <g transform="translate(150, 80)" filter="url(#glow)">
    <rect x="0" y="0" width="300" height="440" rx="36" fill="#334155" stroke="#64748b" stroke-width="4"/>
    <rect x="12" y="12" width="276" height="416" rx="28" fill="#020617"/>
    
    <!-- Screen Content / Camera Layout according to angle -->
    

    
      <!-- Matte Back Finish -->
      <rect x="14" y="14" width="272" height="412" rx="26" fill="#1e293b"/>
      <!-- Triple Camera Island -->
      <rect x="30" y="30" width="110" height="120" rx="24" fill="#0f172a" stroke="#475569" stroke-width="2"/>
      <circle cx="60" cy="60" r="18" fill="#000000" stroke="#94a3b8" stroke-width="3"/>
      <circle cx="60" cy="60" r="7" fill="#1e3a8a"/>
      <circle cx="60" cy="120" r="18" fill="#000000" stroke="#94a3b8" stroke-width="3"/>
      <circle cx="60" cy="120" r="7" fill="#1e3a8a"/>
      <circle cx="110" cy="90" r="18" fill="#000000" stroke="#94a3b8" stroke-width="3"/>
      <circle cx="110" cy="90" r="7" fill="#1e3a8a"/>
      <circle cx="110" cy="50" r="6" fill="#fef08a"/> <!-- Flash -->
      <text x="150" y="320" fill="#94a3b8" font-family="system-ui, sans-serif" font-size="16" font-weight="bold" text-anchor="middle">48MP Triple AI Optics</text>
    

    

    

    
  </g>

  <!-- Angle Tag Overlay -->
  <rect x="24" y="530" width="220" height="42" rx="10" fill="rgba(0,0,0,0.7)" stroke="rgba(255,255,255,0.2)" stroke-width="1"/>
  <text x="38" y="556" fill="#38bdf8" font-family="system-ui, sans-serif" font-size="14" font-weight="700">📷 Back View</text>
  
  <rect x="380" y="530" width="196" height="42" rx="10" fill="#16a34a"/>
  <text x="478" y="556" fill="#ffffff" font-family="system-ui, sans-serif" font-size="13" font-weight="700" text-anchor="middle">UGX 40,000 Verified</text>
</svg>