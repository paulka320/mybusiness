<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= category.name %> | EasyMarket</title>
    <link rel="stylesheet" href="style.css">
    <script src="script.js" defer></script>
</head>
<body>
<%- include('header') %>
<main>
    <section class="section">
        <div class="section-heading">
            <div>
                <h2><%= category.name %></h2>
                <p>Browse all products in this category.</p>
            </div>
        </div>
        <div class="category-list category-list--compact">
            <% categories.forEach(function(cat) { %>
                <a href="category.php?id=<%= cat.id %>" class="category-pill<%= cat.id === category.id ? ' active' : '' %>"><%= cat.name %></a>
            <% }); %>
        </div>
    </section>

    <section class="section filter-section">
        <form class="filter-form" method="GET" action="category.php">
            <input type="hidden" name="id" value="<%= category.id %>">
            <div class="filter-row">
                <div class="filter-field">
                    <label>Search</label>
                    <input type="search" name="search" value="<%= search %>" placeholder="Search within category">
                </div>
                <div class="filter-field">
                    <label>Sort by</label>
                    <select name="sort">
                        <option value="newest" <%= sort === 'newest' ? 'selected' : '' %>>Newest</option>
                        <option value="price_asc" <%= sort === 'price_asc' ? 'selected' : '' %>>Price: Low to High</option>
                        <option value="price_desc" <%= sort === 'price_desc' ? 'selected' : '' %>>Price: High to Low</option>
                        <option value="title" <%= sort === 'title' ? 'selected' : '' %>>Title A–Z</option>
                    </select>
                </div>
            </div>
            <div class="filter-actions">
                <button type="submit">Apply</button>
                <a class="reset-link" href="category.php?id=<%= category.id %>">Reset</a>
            </div>
        </form>
    </section>

    <section class="section products-section">
        <% if (products && products.length > 0) { %>
            <div class="products-grid">
                <% products.forEach(function(row) { %>
                    <article class="product-card">
                        <a class="product-link" href="product.php?id=<%= row.id %>">
                            <div class="product-image">
                                <img src="uploads/<%= row.image %>" alt="<%= row.title %>">
                            </div>
                            <div class="product-body">
                                <h3><%= row.title %></h3>
                                <p class="product-description"><%= row.description ? (row.description.length > 90 ? row.description.substring(0, 90) + '...' : row.description) : '' %></p>
                                <div class="product-footer">
                                    <span class="price">UGX <%= Number(row.price).toLocaleString() %></span>
                                    <span class="location">📍 <%= row.location %></span>
                                </div>
                                <p class="product-stock">In stock: <%= parseInt(row.quantity, 10) %></p>
                            </div>
                        </a>
                        <button class="cart-action" type="button" data-id="<%= row.id %>" data-title="<%= row.title %>" data-price="<%= row.price %>" data-image="<%= row.image %>">Add to Cart</button>
                    </article>
                <% }); %>
            </div>
        <% } else { %>
            <div class="empty-state">
                <div class="empty-state-icon">🏷️</div>
                <h3>No products in <%= category.name %> yet</h3>
                <p>Be the first merchant to list an item in <%= category.name %> or browse our other categories.</p>
                <div class="empty-state-actions">
                    <a href="upload.php" class="btn-primary">➕ Sell in <%= category.name %></a>
                    <a href="index.php" class="btn-secondary">Browse All</a>
                </div>
            </div>
        <% } %>
    </section>
</main>
</body>
</html>
