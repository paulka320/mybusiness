<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= product.title %> | EasyMarket Uganda</title>
    <link rel="stylesheet" href="style.css">
    <script src="script.js" defer></script>
</head>
<body>
<%- include('header') %>
<main class="section product-detail-section">
    <div class="section-heading">
        <div>
            <h2><%= product.title %></h2>
            <div style="display: flex; align-items: center; gap: 8px; margin-top: 4px;">
                <span class="badge-tag"><%= product.category_name || 'General' %></span>
                <span style="font-size: 13px; color: #64748b;">📍 <%= product.location %> · Verified Uganda Seller</span>
            </div>
        </div>
        <div class="verified-authenticity-badge">
            <span>🛡️ 10-Point Authenticity Guaranteed</span>
        </div>
    </div>

    <div class="product-detail-grid">
        <!-- 5-Angle Verified Multi-Photo Gallery -->
        <div class="product-detail-gallery-container">
            <div class="product-gallery-main-stage" id="product-gallery-stage">
                <% 
                   var galleryList = (images && images.length > 0) ? images : [{ image_path: product.image || 'phone-front.svg', is_main: 1 }];
                   var angleLabels = ['Front View (Main)', 'Back Perspective', 'Left Profile', 'Right Profile', 'Top / Detail Angle', 'Additional Angle 6', 'Additional Angle 7', 'Additional Angle 8'];
                %>
                
                <div class="gallery-viewport">
                    <% galleryList.forEach(function(img, idx) { %>
                        <% var pImg = img.image_path && (img.image_path.startsWith('http') || img.image_path.startsWith('/') || img.image_path.startsWith('data:')) ? img.image_path : ('/uploads/' + (img.image_path || 'phone-front.svg')); %>
                        <img 
                            src="<%= pImg %>" 
                            onerror="this.onerror=null;this.src='/phone-front.svg';" 
                            alt="<%= product.title %> - <%= angleLabels[idx] || ('Angle ' + (idx + 1)) %>" 
                            class="gallery-slide-img <%= idx === 0 ? 'active' : '' %>"
                            data-index="<%= idx %>"
                            id="gallery-slide-<%= idx %>"
                        >
                    <% }); %>

                    <% if (galleryList.length > 1) { %>
                        <button type="button" class="gallery-nav-btn gallery-prev" id="gallery-btn-prev" aria-label="Previous Perspective">‹</button>
                        <button type="button" class="gallery-nav-btn gallery-next" id="gallery-btn-next" aria-label="Next Perspective">›</button>
                    <% } %>

                    <div class="gallery-angle-badge" id="gallery-angle-badge">
                        📸 <span><%= angleLabels[0] || 'Angle 1 of ' + galleryList.length %></span>
                    </div>
                </div>
            </div>

            <!-- Multi-Angle Thumbnails Strip -->
            <% if (galleryList.length > 1) { %>
                <div class="gallery-thumbnails-strip" id="gallery-thumbnails-strip">
                    <% galleryList.forEach(function(img, idx) { %>
                        <% var pImg = img.image_path && (img.image_path.startsWith('http') || img.image_path.startsWith('/') || img.image_path.startsWith('data:')) ? img.image_path : ('/uploads/' + (img.image_path || 'phone-front.svg')); %>
                        <button 
                            type="button" 
                            class="gallery-thumb-btn <%= idx === 0 ? 'active' : '' %>" 
                            data-index="<%= idx %>"
                            data-label="<%= angleLabels[idx] || ('Angle ' + (idx + 1) + ' of ' + galleryList.length) %>"
                            aria-label="View <%= angleLabels[idx] || ('Angle ' + (idx + 1)) %>"
                        >
                            <img src="<%= pImg %>" onerror="this.onerror=null;this.src='/phone-front.svg';" alt="Thumb <%= idx + 1 %>">
                            <span class="thumb-label"><%= (idx + 1) %></span>
                        </button>
                    <% }); %>
                </div>
                <div style="display: flex; align-items: center; justify-content: space-between; font-size: 12px; color: #64748b; margin-top: 8px;">
                    <span>🛡️ <strong><%= galleryList.length %> Verified Angles</strong> uploaded</span>
                    <span>Click any photo to switch perspective</span>
                </div>
            <% } %>
        </div>

        <!-- Product Details, Purchase & Direct Messaging -->
        <div class="product-detail-info">
            <p class="product-detail-price">UGX <%= Number(product.price).toLocaleString() %></p>
            
            <!-- Seller / Owner Direct Price Management or Pending Admin Proposal Banner -->
            <% if (locals.isOwner) { %>
                <div style="background: #eff6ff; border: 1px solid #bfdbfe; border-radius: 12px; padding: 14px; margin-bottom: 16px;">
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
                        <span style="font-size: 13px; font-weight: 700; color: #1e40af;">👑 You are the Publisher of this Product</span>
                        <a href="/my_products.php" style="font-size: 12px; font-weight: 600; color: #2563eb; text-decoration: none;">Manage All Listings →</a>
                    </div>
                    
                    <% if (locals.pendingPriceRequest) { %>
                        <div style="background: #fffbeb; border: 1px solid #fde68a; border-radius: 8px; padding: 10px; margin-bottom: 10px;">
                            <div style="font-size: 12px; font-weight: 700; color: #92400e; margin-bottom: 4px;">
                                🏷️ Admin Proposed New Price: UGX <%= Number(pendingPriceRequest.proposed_price).toLocaleString() %>
                            </div>
                            <div style="font-size: 11px; color: #78350f; margin-bottom: 8px;">
                                Reason: <%= pendingPriceRequest.reason || 'Marketplace alignment' %>
                            </div>
                            <form method="POST" action="/seller/price-request/respond" style="display: flex; gap: 8px;">
                                <input type="hidden" name="request_id" value="<%= pendingPriceRequest.id %>">
                                <button type="submit" name="decision" value="Accepted" style="background: #16a34a; color: #fff; border: none; padding: 5px 12px; border-radius: 6px; font-size: 11px; font-weight: 700; cursor: pointer;">
                                    ✅ Accept Price (UGX <%= Number(pendingPriceRequest.proposed_price).toLocaleString() %>)
                                </button>
                                <button type="submit" name="decision" value="Rejected" style="background: #fee2e2; color: #dc2626; border: 1px solid #fca5a5; padding: 5px 10px; border-radius: 6px; font-size: 11px; font-weight: 700; cursor: pointer;">
                                    ❌ Decline
                                </button>
                            </form>
                        </div>
                    <% } %>

                    <form method="POST" action="/seller/update-price" style="display: flex; align-items: center; gap: 8px; flex-wrap: wrap;">
                        <input type="hidden" name="product_id" value="<%= product.id %>">
                        <label style="font-size: 12px; font-weight: 700; color: #1e3a8a; margin: 0;">Change Your Price:</label>
                        <input type="number" name="price" value="<%= product.price %>" step="100" min="500" style="width: 110px; padding: 5px 8px; font-size: 12px; font-weight: 700; border-radius: 6px; border: 1px solid #93c5fd;" required>
                        <label style="font-size: 12px; font-weight: 700; color: #1e3a8a; margin: 0;">Stock:</label>
                        <input type="number" name="quantity" value="<%= product.quantity %>" min="0" style="width: 60px; padding: 5px 8px; font-size: 12px; font-weight: 700; border-radius: 6px; border: 1px solid #93c5fd;" required>
                        <button type="submit" style="background: #2563eb; color: #fff; border: none; padding: 6px 12px; border-radius: 6px; font-size: 12px; font-weight: 700; cursor: pointer;">
                            Update Live Price
                        </button>
                    </form>
                </div>
            <% } else if (locals.isAdmin) { %>
                <div style="background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 12px; padding: 14px; margin-bottom: 16px;">
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 6px;">
                        <span style="font-size: 13px; font-weight: 700; color: #0f172a;">⚡ Admin Marketplace Control</span>
                        <a href="/admin_dashboard?tab=inventory" style="font-size: 12px; color: #2563eb; font-weight: 600; text-decoration: none;">Admin Suite →</a>
                    </div>
                    <div style="font-size: 11px; color: #64748b; margin-bottom: 8px;">
                        Publisher: Seller #<%= product.seller_id || 1 %>. Admin can delete sold items or propose price adjustments requiring seller approval.
                    </div>
                    <div style="display: flex; gap: 8px; flex-wrap: wrap;">
                        <% if (product.quantity <= 0) { %>
                            <form method="POST" action="/admin_dashboard/delete-product" onsubmit="return confirm('Permanently delete this sold product?');">
                                <input type="hidden" name="product_id" value="<%= product.id %>">
                                <button type="submit" style="background: #dc2626; color: #fff; border: none; padding: 6px 12px; border-radius: 6px; font-size: 12px; font-weight: 700; cursor: pointer;">
                                    🗑️ Delete Sold Product Listing
                                </button>
                            </form>
                        <% } %>
                    </div>
                </div>
            <% } %>

            <% if (product.quantity > 0) { %>
                <form class="add-to-cart-form" method="POST" action="">
                    <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 14px;">
                        <label style="margin: 0; font-weight: 600;">Quantity:</label>
                        <input type="number" name="quantity" min="1" max="<%= product.quantity %>" value="1" style="width: 80px; padding: 8px 12px;" required>
                        <span style="font-size: 13px; color: #16a34a; font-weight: 600;">
                            <%= product.quantity %> available in stock
                        </span>
                    </div>
                    <button type="submit" class="cart-action" data-id="<%= product.id %>" data-title="<%= product.title %>" data-price="<%= product.price %>" data-image="<%= product.image %>">
                        🛒 Add to Cart & Buy Securely
                    </button>
                </form>
            <% } else { %>
                <div style="background: #fee2e2; border: 1px solid #fecaca; color: #991b1b; padding: 12px 16px; border-radius: 10px; margin-bottom: 14px; font-weight: 700; font-size: 14px; display: flex; align-items: center; gap: 8px;">
                    <span>🔴</span>
                    <span>This item is currently sold out and unavailable for immediate checkout.</span>
                </div>
            <% } %>

            <!-- WhatsApp & In-App Direct Communication Options -->
            <div class="seller-contact-card">
                <div style="font-size: 13px; font-weight: 700; color: #1e293b; margin-bottom: 8px; text-transform: uppercase; letter-spacing: 0.5px;">
                    Direct Communication with Seller
                </div>
                <div class="contact-buttons-group">
                    <% if (locals.waLink) { %>
                        <a href="<%= waLink %>" target="_blank" rel="noopener noreferrer" class="btn-whatsapp" id="btn-chat-whatsapp">
                            <span style="font-size: 18px;">💬</span>
                            <span>Chat on WhatsApp</span>
                        </a>
                    <% } %>

                    <a href="messages.php?to=<%= product.seller_id || 2 %>&product_id=<%= product.id %>" class="btn-inapp-msg" id="btn-chat-inapp">
                        <span style="font-size: 18px;">✉️</span>
                        <span>In-App Direct Message</span>
                    </a>
                </div>
                <div style="font-size: 12px; color: #64748b; margin-top: 8px;">
                    📞 Direct Call: <strong><%= product.phone %></strong>
                </div>
            </div>

            <div class="product-detail-meta" style="margin-top: 18px;">
                <p><strong>📍 Delivery / Pickup:</strong> <%= product.location %></p>
                <p><strong>💳 Payment Code:</strong> <%= product.payment_code || 'Direct MM' %></p>
            </div>

            <div class="product-detail-description">
                <h3>Product Specifications & Details</h3>
                <div style="line-height: 1.7; color: #334155;">
                    <%- (product.description || '').replace(/\n/g, '<br>') %>
                </div>
            </div>
        </div>
    </div>

    <% if (similar && similar.length > 0) { %>
        <section class="section" style="margin-top: 48px;">
            <div class="section-heading">
                <h2>Similar Verified Listings in <%= product.category_name || 'Uganda' %></h2>
            </div>
            <div class="products-grid">
                <% similar.forEach(function(row) { %>
                    <article class="product-card">
                        <a class="product-link" href="product.php?id=<%= row.id %>">
                            <div class="product-image">
                                <img src="<%= row.image && (row.image.startsWith('http') || row.image.startsWith('data:') || row.image.startsWith('/')) ? row.image : ('/uploads/' + (row.image || 'phone-front.svg')) %>" onerror="this.onerror=null;this.src='/phone-front.svg';" alt="<%= row.title %>">
                            </div>
                            <div class="product-body">
                                <h3><%= row.title %></h3>
                                <div class="product-footer">
                                    <span class="price">UGX <%= Number(row.price).toLocaleString() %></span>
                                    <span class="location">📍 <%= row.location %></span>
                                </div>
                            </div>
                        </a>
                    </article>
                <% }); %>
            </div>
        </section>
    <% } %>
</main>
</body>
</html>
