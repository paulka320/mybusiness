<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= product.title %> | EasyMarket Uganda</title>
    <link rel="stylesheet" href="style.css">
    <script src="script.js" defer></script>
</head>
<body>
<%- include('header') %>
<main class="section product-detail-section">
    <div class="section-heading">
        <div>
            <h2><%= product.title %></h2>
            <div style="display: flex; align-items: center; gap: 8px; margin-top: 4px;">
                <span class="badge-tag"><%= product.category_name || 'General' %></span>
                <span style="font-size: 13px; color: #64748b;">📍 <%= product.location %> · Verified Uganda Seller</span>
            </div>
        </div>
        <div class="verified-authenticity-badge">
            <span>🛡️ 10-Point Authenticity Guaranteed</span>
        </div>
    </div>

    <div class="product-detail-grid">
        <!-- 5-Angle Image Gallery & Carousel -->
        <div class="product-detail-image">
            <div class="image-carousel">
                <% if (images && images.length > 0) { %>
                    <% images.forEach(function(img) { %>
                        <% var pImg = img.image_path && (img.image_path.startsWith('http') || img.image_path.startsWith('/') || img.image_path.startsWith('data:')) ? img.image_path : ('/uploads/' + (img.image_path || 'phone-front.svg')); %>
                        <img src="<%= pImg %>" onerror="this.onerror=null;this.src='/phone-front.svg';" alt="<%= product.title %>" class="carousel-image">
                    <% }); %>
                <% } else { %>
                    <% var mainImg = product.image && (product.image.startsWith('http') || product.image.startsWith('/') || product.image.startsWith('data:')) ? product.image : ('/uploads/' + (product.image || 'phone-front.svg')); %>
                    <img src="<%= mainImg %>" onerror="this.onerror=null;this.src='/phone-front.svg';" alt="<%= product.title %>" class="carousel-image">
                <% } %>
            </div>
            <% if (images && images.length > 1) { %>
                <button class="carousel-prev" aria-label="Previous image">&lt;</button>
                <button class="carousel-next" aria-label="Next image">&gt;</button>
                <div class="carousel-indicators">
                    <% for (var i = 0; i < images.length; i++) { %>
                        <button class="indicator<%= i === 0 ? ' active' : '' %>" data-index="<%= i %>"></button>
                    <% } %>
                </div>
                <p class="hint">📸 5-Angle Verified Views: Click arrows or dots to examine all perspectives.</p>
            <% } %>
        </div>

        <!-- Product Details, Purchase & Direct Messaging -->
        <div class="product-detail-info">
            <p class="product-detail-price">UGX <%= Number(product.price).toLocaleString() %></p>
            
            <form class="add-to-cart-form" method="POST" action="">
                <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 14px;">
                    <label style="margin: 0; font-weight: 600;">Quantity:</label>
                    <input type="number" name="quantity" min="1" max="<%= product.quantity %>" value="1" style="width: 80px; padding: 8px 12px;" required>
                    <span style="font-size: 13px; color: #16a34a; font-weight: 600;">
                        <%= product.quantity %> available in stock
                    </span>
                </div>
                <button type="submit" class="cart-action" data-id="<%= product.id %>" data-title="<%= product.title %>" data-price="<%= product.price %>" data-image="<%= product.image %>">
                    🛒 Add to Cart & Buy Securely
                </button>
            </form>

            <!-- WhatsApp & In-App Direct Communication Options -->
            <div class="seller-contact-card">
                <div style="font-size: 13px; font-weight: 700; color: #1e293b; margin-bottom: 8px; text-transform: uppercase; letter-spacing: 0.5px;">
                    Direct Communication with Seller
                </div>
                <div class="contact-buttons-group">
                    <% if (locals.waLink) { %>
                        <a href="<%= waLink %>" target="_blank" rel="noopener noreferrer" class="btn-whatsapp" id="btn-chat-whatsapp">
                            <span style="font-size: 18px;">💬</span>
                            <span>Chat on WhatsApp</span>
                        </a>
                    <% } %>

                    <a href="messages.php?to=<%= product.seller_id || 2 %>&product_id=<%= product.id %>" class="btn-inapp-msg" id="btn-chat-inapp">
                        <span style="font-size: 18px;">✉️</span>
                        <span>In-App Direct Message</span>
                    </a>
                </div>
                <div style="font-size: 12px; color: #64748b; margin-top: 8px;">
                    📞 Direct Call: <strong><%= product.phone %></strong>
                </div>
            </div>

            <div class="product-detail-meta" style="margin-top: 18px;">
                <p><strong>📍 Delivery / Pickup:</strong> <%= product.location %></p>
                <p><strong>💳 Payment Code:</strong> <%= product.payment_code || 'Direct MM' %></p>
            </div>

            <div class="product-detail-description">
                <h3>Product Specifications & Details</h3>
                <div style="line-height: 1.7; color: #334155;">
                    <%- (product.description || '').replace(/\n/g, '<br>') %>
                </div>
            </div>
        </div>
    </div>

    <% if (similar && similar.length > 0) { %>
        <section class="section" style="margin-top: 48px;">
            <div class="section-heading">
                <h2>Similar Verified Listings in <%= product.category_name || 'Uganda' %></h2>
            </div>
            <div class="products-grid">
                <% similar.forEach(function(row) { %>
                    <article class="product-card">
                        <a class="product-link" href="product.php?id=<%= row.id %>">
                            <div class="product-image">
                                <img src="uploads/<%= row.image %>" alt="<%= row.title %>">
                            </div>
                            <div class="product-body">
                                <h3><%= row.title %></h3>
                                <div class="product-footer">
                                    <span class="price">UGX <%= Number(row.price).toLocaleString() %></span>
                                    <span class="location">📍 <%= row.location %></span>
                                </div>
                            </div>
                        </a>
                    </article>
                <% }); %>
            </div>
        </section>
    <% } %>
</main>
</body>
</html>
