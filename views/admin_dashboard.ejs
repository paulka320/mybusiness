<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Command Center | EasyMarket Uganda</title>
    <link rel="stylesheet" href="/style.css">
    <script src="/script.js" defer></script>
</head>
<body style="background: #f8fafc; color: #0f172a;">
<%- include('header') %>

<main class="section" style="max-width: 1280px; padding: 24px 20px;">
    <!-- Admin Top Header Banner -->
    <div class="admin-header-banner" style="background: linear-gradient(135deg, #1e293b 0%, #0f172a 100%); color: #ffffff; padding: 24px; border-radius: 16px; margin-bottom: 24px; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 16px; box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.1);">
        <div>
            <div style="display: flex; align-items: center; gap: 10px;">
                <span style="font-size: 28px;">⚡</span>
                <h1 style="margin: 0; font-size: 1.75rem; font-weight: 800; letter-spacing: -0.5px; color: #ffffff;">EasyMarket Admin Command Suite</h1>
            </div>
            <p style="margin: 6px 0 0; color: #94a3b8; font-size: 14px;">
                Live inventory tracking, financial payouts, database health monitoring & multi-device sync.
            </p>
        </div>
        <div style="display: flex; align-items: center; gap: 12px; flex-wrap: wrap;">
            <a href="/upload" class="btn-primary" style="padding: 10px 18px; font-size: 13px; font-weight: 600; text-decoration: none;">➕ Add New Product</a>
            <a href="/logout" id="admin-page-logout-btn" class="nav-logout-btn" style="padding: 10px 18px; font-size: 13px; background: rgba(255,255,255,0.1); border: 1px solid rgba(255,255,255,0.2); color: #fff; border-radius: 8px; text-decoration: none; font-weight: 600;">
                🚪 Logout Admin
            </a>
        </div>
    </div>

    <!-- Navigation Tabs -->
    <div class="admin-tab-nav" id="admin-tabs" style="display: flex; gap: 8px; border-bottom: 2px solid #e2e8f0; margin-bottom: 24px; overflow-x: auto; padding-bottom: 8px;">
        <a href="/admin_dashboard?tab=overview" class="admin-tab-btn <%= (!locals.activeTab || activeTab === 'overview') ? 'active' : '' %>" style="text-decoration: none; padding: 10px 16px; font-weight: 600; font-size: 14px; border-radius: 8px; color: <%= (!locals.activeTab || activeTab === 'overview') ? '#2563eb' : '#64748b' %>; background: <%= (!locals.activeTab || activeTab === 'overview') ? '#eff6ff' : 'transparent' %>;">
            📈 Overview & Financials
        </a>
        <a href="/admin_dashboard?tab=inventory" class="admin-tab-btn <%= (activeTab === 'inventory') ? 'active' : '' %>" style="text-decoration: none; padding: 10px 16px; font-weight: 600; font-size: 14px; border-radius: 8px; color: <%= (activeTab === 'inventory') ? '#2563eb' : '#64748b' %>; background: <%= (activeTab === 'inventory') ? '#eff6ff' : 'transparent' %>; display: flex; align-items: center; gap: 6px;">
            📦 Inventory & Catalog
            <% if (stats.inventory.lowStock.length > 0) { %>
                <span style="background: #f97316; color: white; padding: 2px 7px; border-radius: 10px; font-size: 11px;"><%= stats.inventory.lowStock.length %> low</span>
            <% } %>
        </a>
        <a href="/admin_dashboard?tab=orders" class="admin-tab-btn <%= (activeTab === 'orders') ? 'active' : '' %>" style="text-decoration: none; padding: 10px 16px; font-weight: 600; font-size: 14px; border-radius: 8px; color: <%= (activeTab === 'orders') ? '#2563eb' : '#64748b' %>; background: <%= (activeTab === 'orders') ? '#eff6ff' : 'transparent' %>; display: flex; align-items: center; gap: 6px;">
            🚚 Orders & Fulfillment
            <% if (stats.fulfillmentQueue.pending > 0) { %>
                <span style="background: #eab308; color: #713f12; padding: 2px 7px; border-radius: 10px; font-size: 11px;"><%= stats.fulfillmentQueue.pending %> pending</span>
            <% } %>
        </a>
        <a href="/admin_dashboard?tab=customers" class="admin-tab-btn <%= (activeTab === 'customers') ? 'active' : '' %>" style="text-decoration: none; padding: 10px 16px; font-weight: 600; font-size: 14px; border-radius: 8px; color: <%= (activeTab === 'customers') ? '#2563eb' : '#64748b' %>; background: <%= (activeTab === 'customers') ? '#eff6ff' : 'transparent' %>; display: flex; align-items: center; gap: 6px;">
            👥 Customers & Tickets
            <% if (stats.customerInsights.openTicketsCount > 0) { %>
                <span style="background: #ea580c; color: white; padding: 2px 7px; border-radius: 10px; font-size: 11px;"><%= stats.customerInsights.openTicketsCount %></span>
            <% } %>
        </a>
        <a href="/admin_dashboard?tab=marketing" class="admin-tab-btn <%= (activeTab === 'marketing') ? 'active' : '' %>" style="text-decoration: none; padding: 10px 16px; font-weight: 600; font-size: 14px; border-radius: 8px; color: <%= (activeTab === 'marketing') ? '#2563eb' : '#64748b' %>; background: <%= (activeTab === 'marketing') ? '#eff6ff' : 'transparent' %>;">
            📢 Campaigns & Promo
        </a>
    </div>

    <!-- 1. OVERVIEW & FINANCIALS TAB -->
    <% if (!locals.activeTab || activeTab === 'overview') { %>
    <section class="admin-section-block">
        
        <!-- FINANCIAL FORECAST & OWNER PAYOUT CARDS -->
        <div style="background: #ffffff; border: 1px solid #e2e8f0; border-radius: 16px; padding: 24px; margin-bottom: 24px; box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);">
            <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px; margin-bottom: 20px; border-bottom: 1px solid #f1f5f9; padding-bottom: 14px;">
                <div>
                    <h2 style="margin: 0; font-size: 1.25rem; font-weight: 800; color: #0f172a; display: flex; align-items: center; gap: 8px;">
                        💰 Financial Valuation & Owner Payout Forecast
                    </h2>
                    <p style="margin: 4px 0 0; font-size: 13px; color: #64748b;">
                        Calculated from all active products uploaded across the entire marketplace catalog.
                    </p>
                </div>
                
                <!-- Commission Rate Adjuster Form -->
                <form method="POST" action="/admin_dashboard/commission-rate" style="display: flex; align-items: center; gap: 8px; background: #f8fafc; padding: 8px 14px; border-radius: 10px; border: 1px solid #cbd5e1;">
                    <label style="font-size: 12px; font-weight: 700; color: #334155; margin: 0;">Owner Cut / Commission Rate:</label>
                    <div style="display: flex; align-items: center; gap: 4px;">
                        <input type="number" name="commission_rate" min="0" max="100" step="0.5" value="<%= stats.financialForecast.ownerCommissionPercentage %>" style="width: 60px; padding: 4px 8px; font-size: 13px; font-weight: 700; border-radius: 6px; border: 1px solid #94a3b8; text-align: center;" required>
                        <span style="font-weight: 700; color: #334155;">%</span>
                    </div>
                    <button type="submit" class="btn-sm-action" style="background: #2563eb; color: white; border: none; padding: 6px 12px; border-radius: 6px; font-size: 12px; font-weight: 600; cursor: pointer;">
                        Set Rate
                    </button>
                </form>
            </div>

            <!-- Financial Metrics Grid -->
            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 16px;">
                <!-- Total Catalog Revenue Expected -->
                <div style="background: #f0fdf4; border: 1px solid #bbf7d0; border-radius: 12px; padding: 18px;">
                    <div style="font-size: 12px; font-weight: 700; color: #166534; text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 6px;">
                        💵 Total Expected Catalog Revenue
                    </div>
                    <div style="font-size: 1.6rem; font-weight: 800; color: #15803d; letter-spacing: -0.5px;">
                        UGX <%= Number(stats.financialForecast.totalExpectedCatalogRevenue).toLocaleString() %>
                    </div>
                    <div style="font-size: 12px; color: #166534; margin-top: 6px;">
                        Sum value of all <%= stats.inventory.totalStockUnits %> inventory units
                    </div>
                </div>

                <!-- Owner Total Payout (Admin Cut to Phone) -->
                <div style="background: #eff6ff; border: 2px solid #3b82f6; border-radius: 12px; padding: 18px; box-shadow: 0 4px 12px rgba(59, 130, 246, 0.1);">
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 6px;">
                        <span style="font-size: 12px; font-weight: 700; color: #1e40af; text-transform: uppercase; letter-spacing: 0.5px;">
                            ⭐ Owner Cut (To Send to My Number)
                        </span>
                        <span style="background: #2563eb; color: white; font-size: 11px; font-weight: 700; padding: 2px 6px; border-radius: 6px;">
                            <%= stats.financialForecast.ownerCommissionPercentage %>% Share
                        </span>
                    </div>
                    <div style="font-size: 1.6rem; font-weight: 800; color: #1d4ed8; letter-spacing: -0.5px;">
                        UGX <%= Number(stats.financialForecast.ownerShareAmount).toLocaleString() %>
                    </div>
                    <div style="font-size: 12px; color: #1e40af; margin-top: 6px; display: flex; align-items: center; gap: 6px;">
                        <span>📱 Payout Number:</span>
                        <strong><%= stats.financialForecast.ownerPhoneNumber %></strong>
                    </div>
                </div>

                <!-- Sellers Net Share -->
                <div style="background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 12px; padding: 18px;">
                    <div style="font-size: 12px; font-weight: 700; color: #475569; text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 6px;">
                        📦 Net Sellers Revenue
                    </div>
                    <div style="font-size: 1.6rem; font-weight: 800; color: #334155; letter-spacing: -0.5px;">
                        UGX <%= Number(stats.financialForecast.sellersShareAmount).toLocaleString() %>
                    </div>
                    <div style="font-size: 12px; color: #64748b; margin-top: 6px;">
                        Disbursed to sellers upon delivery confirmation
                    </div>
                </div>

                <!-- Actual Delivered Sales Revenue -->
                <div style="background: #fefce8; border: 1px solid #fef08a; border-radius: 12px; padding: 18px;">
                    <div style="font-size: 12px; font-weight: 700; color: #854d0e; text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 6px;">
                        🚚 Realized Gross Sales
                    </div>
                    <div style="font-size: 1.6rem; font-weight: 800; color: #a16207; letter-spacing: -0.5px;">
                        UGX <%= Number(stats.core.totalGrossSales).toLocaleString() %>
                    </div>
                    <div style="font-size: 12px; color: #854d0e; margin-top: 6px;">
                        From <%= stats.core.totalOrders %> placed customer orders
                    </div>
                </div>
            </div>
        </div>

        <!-- 2-COLUMN GRID: LIVE DATABASE HEALTH & INVENTORY HEALTH METRICS -->
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(340px, 1fr)); gap: 24px; margin-bottom: 24px;">
            
            <!-- LIVE DATABASE HEALTH MONITOR & SYNC SUITE -->
            <div style="background: #ffffff; border: 1px solid #e2e8f0; border-radius: 16px; padding: 22px; box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px; border-bottom: 1px solid #f1f5f9; padding-bottom: 12px;">
                    <h3 style="margin: 0; font-size: 1.1rem; font-weight: 800; color: #0f172a; display: flex; align-items: center; gap: 8px;">
                        🖥️ Supabase & Database Sync Suite
                    </h3>
                    <% if (stats.database.isConnected) { %>
                        <span style="background: #dcfce7; color: #15803d; border: 1px solid #86efac; font-size: 12px; font-weight: 700; padding: 4px 10px; border-radius: 20px; display: inline-flex; align-items: center; gap: 6px;">
                            <span style="display: inline-block; width: 8px; height: 8px; background: #22c55e; border-radius: 50%;"></span>
                            SUPABASE ACTIVE & SYNCED
                        </span>
                    <% } else { %>
                        <span style="background: #fef3c7; color: #b45309; border: 1px solid #fde68a; font-size: 12px; font-weight: 700; padding: 4px 10px; border-radius: 20px; display: inline-flex; align-items: center; gap: 6px;">
                            <span style="display: inline-block; width: 8px; height: 8px; background: #f59e0b; border-radius: 50%;"></span>
                            IN-MEMORY MODE
                        </span>
                    <% } %>
                </div>

                <% if (locals.syncResult) { %>
                    <div style="margin-bottom: 14px; padding: 12px 14px; border-radius: 10px; font-size: 13px; <%= syncResult.success ? 'background: #f0fdf4; border: 1px solid #86efac; color: #166534;' : 'background: #fef2f2; border: 1px solid #fca5a5; color: #991b1b;' %>">
                        <strong><%= syncResult.success ? '✅ Database Synchronization Completed Successfully!' : '⚠️ Sync Warning:' %></strong>
                        <% if (syncResult.counts) { %>
                            <div style="margin-top: 6px; font-size: 12px; display: flex; gap: 12px; flex-wrap: wrap;">
                                <span>📦 Products in DB: <strong><%= syncResult.counts.products %></strong></span>
                                <span>🖼️ Photos: <strong><%= syncResult.counts.product_images %></strong></span>
                                <span>👥 Users: <strong><%= syncResult.counts.users %></strong></span>
                                <span>🛒 Orders: <strong><%= syncResult.counts.orders %></strong></span>
                            </div>
                        <% } else if (syncResult.message || syncResult.error) { %>
                            <p style="margin: 4px 0 0;"><%= syncResult.message || syncResult.error %></p>
                        <% } %>
                    </div>
                <% } %>

                <div style="display: flex; flex-direction: column; gap: 12px;">
                    <div style="display: flex; justify-content: space-between; align-items: center; padding: 10px 14px; background: #f8fafc; border-radius: 10px; font-size: 13px;">
                        <span style="color: #64748b; font-weight: 600;">Database Engine:</span>
                        <strong style="color: #0f172a;"><%= stats.database.type %></strong>
                    </div>

                    <div style="display: flex; justify-content: space-between; align-items: center; padding: 10px 14px; background: #f8fafc; border-radius: 10px; font-size: 13px;">
                        <span style="color: #64748b; font-weight: 600;">Cross-Device Persistence:</span>
                        <% if (stats.database.isConnected) { %>
                            <strong style="color: #16a34a;">🟢 Instant & Globally Persistent</strong>
                        <% } else { %>
                            <strong style="color: #ea580c;">🟡 Local Container Memory</strong>
                        <% } %>
                    </div>

                    <div style="display: flex; justify-content: space-between; align-items: center; padding: 10px 14px; background: #f8fafc; border-radius: 10px; font-size: 13px;">
                        <span style="color: #64748b; font-weight: 600;">Live Query Latency:</span>
                        <strong style="color: <%= (stats.database.latencyMs && stats.database.latencyMs < 100) ? '#16a34a' : '#2563eb' %>;">
                            <%= stats.database.latencyMs ? (stats.database.latencyMs + ' ms (Fast)') : 'Local (0 ms)' %>
                        </strong>
                    </div>

                    <!-- Sync & Test Database Button -->
                    <div style="margin-top: 6px; display: flex; justify-content: space-between; align-items: center; background: #f1f5f9; padding: 10px 14px; border-radius: 10px;">
                        <div style="font-size: 12px; color: #475569;">
                            Sync uploaded catalog & verify tables
                        </div>
                        <form method="POST" action="/admin_dashboard/sync-database" style="margin: 0;">
                            <button type="submit" style="background: #2563eb; color: white; border: none; padding: 7px 14px; border-radius: 8px; font-size: 12px; font-weight: 700; cursor: pointer; display: flex; align-items: center; gap: 6px;">
                                ⚡ Sync Database Now
                            </button>
                        </form>
                    </div>
                </div>
            </div>

            <!-- INVENTORY HEALTH OVERVIEW (STATISTICS & COLOR-CODED METRICS) -->
            <div style="background: #ffffff; border: 1px solid #e2e8f0; border-radius: 16px; padding: 22px; box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px; border-bottom: 1px solid #f1f5f9; padding-bottom: 12px;">
                    <h3 style="margin: 0; font-size: 1.1rem; font-weight: 800; color: #0f172a; display: flex; align-items: center; gap: 8px;">
                        📊 Inventory Health & Stock Analytics
                    </h3>
                    <a href="/admin_dashboard?tab=inventory" style="font-size: 12px; font-weight: 700; color: #2563eb; text-decoration: none;">
                        Manage Items →
                    </a>
                </div>

                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px;">
                    <!-- Total Catalog Items (Blue) -->
                    <div style="background: #eff6ff; border: 1px solid #bfdbfe; border-radius: 10px; padding: 14px;">
                        <div style="font-size: 11px; font-weight: 700; color: #1e40af; text-transform: uppercase;">🔵 Catalog Items</div>
                        <div style="font-size: 1.5rem; font-weight: 800; color: #1d4ed8; margin: 4px 0;">
                            <%= stats.inventory.totalProducts %>
                        </div>
                        <div style="font-size: 11px; color: #3b82f6;"><%= stats.inventory.activeProducts %> Active Listings</div>
                    </div>

                    <!-- Total Stock Units (Purple) -->
                    <div style="background: #faf5ff; border: 1px solid #e9d5ff; border-radius: 10px; padding: 14px;">
                        <div style="font-size: 11px; font-weight: 700; color: #6b21a8; text-transform: uppercase;">🟣 Total Inventory Units</div>
                        <div style="font-size: 1.5rem; font-weight: 800; color: #7e22ce; margin: 4px 0;">
                            <%= stats.inventory.totalStockUnits %>
                        </div>
                        <div style="font-size: 11px; color: #9333ea;">Physical Units in Stock</div>
                    </div>

                    <!-- Low Stock Alarm (Orange Warning) -->
                    <div style="background: #fff7ed; border: 1px solid #fed7aa; border-radius: 10px; padding: 14px;">
                        <div style="font-size: 11px; font-weight: 700; color: #9a3412; text-transform: uppercase;">🟠 Low Stock (≤ 3 units)</div>
                        <div style="font-size: 1.5rem; font-weight: 800; color: #c2410c; margin: 4px 0;">
                            <%= stats.inventory.lowStock.length %>
                        </div>
                        <div style="font-size: 11px; color: #ea580c;">Requires replenishment</div>
                    </div>

                    <!-- Out of Stock Alarm (Red Alert) -->
                    <div style="background: #fef2f2; border: 1px solid #fecaca; border-radius: 10px; padding: 14px;">
                        <div style="font-size: 11px; font-weight: 700; color: #991b1b; text-transform: uppercase;">🔴 Out of Stock (0 units)</div>
                        <div style="font-size: 1.5rem; font-weight: 800; color: #dc2626; margin: 4px 0;">
                            <%= stats.inventory.outOfStock.length %>
                        </div>
                        <div style="font-size: 11px; color: #ef4444;">Hidden from marketplace</div>
                    </div>
                </div>
            </div>
        </div>

    </section>
    <% } %>

    <!-- 2. INVENTORY AND CATALOG CONTROL TAB -->
    <% if (activeTab === 'inventory') { %>
    <section class="admin-section-block">
        
        <!-- Stock Alarms Header Grid -->
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 16px; margin-bottom: 24px;">
            <div style="background: #eff6ff; border: 1px solid #bfdbfe; border-radius: 12px; padding: 16px;">
                <div style="font-size: 12px; font-weight: 700; color: #1e40af; text-transform: uppercase;">🔵 Total Listed Catalog Items</div>
                <div style="font-size: 1.6rem; font-weight: 800; color: #1d4ed8; margin: 4px 0;"><%= stats.inventory.totalProducts %> Products</div>
                <div style="font-size: 12px; color: #3b82f6;">Total available stock units: <strong><%= stats.inventory.totalStockUnits %></strong></div>
            </div>

            <div style="background: #fff7ed; border: 1px solid #fed7aa; border-radius: 12px; padding: 16px;">
                <div style="font-size: 12px; font-weight: 700; color: #9a3412; text-transform: uppercase;">🟠 Low Stock Items (Threshold ≤ 3 units)</div>
                <div style="font-size: 1.6rem; font-weight: 800; color: #c2410c; margin: 4px 0;"><%= stats.inventory.lowStock.length %> Items</div>
                <div style="font-size: 12px; color: #ea580c;">Items approaching zero stock</div>
            </div>

            <div style="background: #fef2f2; border: 1px solid #fecaca; border-radius: 12px; padding: 16px;">
                <div style="font-size: 12px; font-weight: 700; color: #991b1b; text-transform: uppercase;">🔴 Out-of-Stock Items</div>
                <div style="font-size: 1.6rem; font-weight: 800; color: #dc2626; margin: 4px 0;"><%= stats.inventory.outOfStock.length %> Items</div>
                <div style="font-size: 12px; color: #ef4444;">Needs inventory restock to go live</div>
            </div>
        </div>

        <!-- Master Product Catalog Table for Admin -->
        <div class="admin-card" style="background: #ffffff; border: 1px solid #e2e8f0; border-radius: 16px; padding: 24px; box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; flex-wrap: wrap; gap: 12px;">
                <div>
                    <h3 style="margin: 0; font-size: 1.25rem; font-weight: 800; color: #0f172a;">
                        📦 All Uploaded Products & Revenue Breakdown
                    </h3>
                    <p style="margin: 4px 0 0; font-size: 13px; color: #64748b;">
                        Live overview of all items uploaded by sellers, expected revenue, and owner cut.
                    </p>
                </div>
                <a href="/upload" class="btn-primary" style="padding: 8px 16px; font-size: 13px; text-decoration: none;">➕ Upload Product</a>
            </div>

            <div class="table-responsive">
                <table class="admin-table" style="width: 100%; border-collapse: collapse;">
                    <thead>
                        <tr style="background: #f8fafc; border-bottom: 2px solid #e2e8f0; text-align: left;">
                            <th style="padding: 12px; font-size: 12px; font-weight: 700; color: #475569;">Photo</th>
                            <th style="padding: 12px; font-size: 12px; font-weight: 700; color: #475569;">Product Details</th>
                            <th style="padding: 12px; font-size: 12px; font-weight: 700; color: #475569;">Seller Contact</th>
                            <th style="padding: 12px; font-size: 12px; font-weight: 700; color: #475569;">Price (UGX)</th>
                            <th style="padding: 12px; font-size: 12px; font-weight: 700; color: #475569;">Stock</th>
                            <th style="padding: 12px; font-size: 12px; font-weight: 700; color: #475569;">Expected Gross</th>
                            <th style="padding: 12px; font-size: 12px; font-weight: 700; color: #475569;">Owner Cut (<%= stats.financialForecast.ownerCommissionPercentage %>%)</th>
                            <th style="padding: 12px; font-size: 12px; font-weight: 700; color: #475569;">Status</th>
                            <th style="padding: 12px; font-size: 12px; font-weight: 700; color: #475569; text-align: center;">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (!products || products.length === 0) { %>
                            <tr>
                                <td colspan="9" style="text-align: center; padding: 36px; color: #64748b;">
                                    <div style="font-size: 28px; margin-bottom: 8px;">🛍️</div>
                                    <strong>No products listed yet in the marketplace.</strong>
                                    <p style="font-size: 13px; margin: 6px 0 0;">Products uploaded by you or sellers will automatically appear here.</p>
                                </td>
                            </tr>
                        <% } else { %>
                            <% products.forEach(function(p) { %>
                                <% 
                                    var itemGross = (p.price || 0) * (p.quantity || 0);
                                    var itemOwnerCut = itemGross * (stats.financialForecast.ownerCommissionPercentage / 100);
                                    var imgSrc = p.image && (p.image.startsWith('http') || p.image.startsWith('data:') || p.image.startsWith('/')) ? p.image : ('/uploads/' + (p.image || 'phone-front.svg'));
                                %>
                                <tr style="border-bottom: 1px solid #f1f5f9;">
                                    <td style="padding: 12px;">
                                        <a href="/product?id=<%= p.id %>" target="_blank">
                                            <img src="<%= imgSrc %>" onerror="this.onerror=null;this.src='/phone-front.svg';" alt="<%= p.title %>" style="width: 48px; height: 48px; object-fit: cover; border-radius: 8px; border: 1px solid #e2e8f0;">
                                        </a>
                                    </td>
                                    <td style="padding: 12px;">
                                        <form id="edit-form-<%= p.id %>" method="POST" action="/admin_dashboard/quick-product">
                                            <input type="hidden" name="product_id" value="<%= p.id %>">
                                            <input type="text" name="title" value="<%= p.title %>" style="font-size: 13px; font-weight: 700; padding: 4px 8px; width: 160px; border-radius: 6px; border: 1px solid #cbd5e1; margin-bottom: 4px;">
                                        </form>
                                        <div style="font-size: 11px; color: #64748b;">
                                            ID: #<%= p.id %> · <span class="badge-tag" style="padding: 1px 6px; font-size: 10px;"><%= p.category_name || 'General' %></span> · 📍 <%= p.location %>
                                        </div>
                                    </td>
                                    <td style="padding: 12px; font-size: 12px;">
                                        <div><strong><%= p.phone %></strong></div>
                                        <% if (p.whatsapp_number) { %>
                                            <a href="https://wa.me/<%= db.sanitizeWhatsAppNumber(p.whatsapp_number) %>?text=<%= encodeURIComponent(`Hello seller, regarding your product listing '${p.title}' on EasyMarket...`) %>" target="_blank" style="color: #16a34a; font-size: 11px; font-weight: 600; display: inline-flex; align-items: center; gap: 2px;">
                                                💬 Chat WhatsApp
                                            </a>
                                        <% } %>
                                    </td>
                                    <td style="padding: 12px;">
                                        <input type="number" form="edit-form-<%= p.id %>" name="price" value="<%= p.price %>" step="100" style="font-size: 12px; font-weight: 700; padding: 4px 8px; width: 95px; border-radius: 6px; border: 1px solid #cbd5e1;">
                                    </td>
                                    <td style="padding: 12px;">
                                        <input type="number" form="edit-form-<%= p.id %>" name="quantity" value="<%= p.quantity %>" min="0" style="font-size: 12px; font-weight: 700; padding: 4px 8px; width: 60px; border-radius: 6px; border: 1px solid #cbd5e1; color: <%= p.quantity <= 3 ? '#ea580c' : '#0f172a' %>;">
                                    </td>
                                    <td style="padding: 12px; font-weight: 700; color: #166534; font-size: 13px;">
                                        UGX <%= Number(itemGross).toLocaleString() %>
                                    </td>
                                    <td style="padding: 12px; font-weight: 800; color: #2563eb; font-size: 13px;">
                                        UGX <%= Number(Math.round(itemOwnerCut)).toLocaleString() %>
                                    </td>
                                    <td style="padding: 12px;">
                                        <select form="edit-form-<%= p.id %>" name="approved" style="font-size: 11px; padding: 4px 6px; border-radius: 6px; border: 1px solid #cbd5e1;">
                                            <option value="1" <%= p.approved === 1 ? 'selected' : '' %>>🟢 Active</option>
                                            <option value="0" <%= p.approved === 0 ? 'selected' : '' %>>🔴 Disabled</option>
                                        </select>
                                    </td>
                                    <td style="padding: 12px; text-align: center;">
                                        <div style="display: flex; justify-content: center; gap: 6px;">
                                            <button type="submit" form="edit-form-<%= p.id %>" class="btn-sm-action" style="background: #2563eb; color: white; border: none; padding: 5px 10px; border-radius: 6px; font-size: 11px; font-weight: 600; cursor: pointer;">
                                                Save
                                            </button>
                                            
                                            <form method="POST" action="/admin_dashboard/delete-product" onsubmit="return confirm('Are you sure you want to permanently delete this listing?');">
                                                <input type="hidden" name="product_id" value="<%= p.id %>">
                                                <button type="submit" style="background: #fee2e2; color: #dc2626; border: 1px solid #fecaca; padding: 5px 8px; border-radius: 6px; font-size: 11px; font-weight: 600; cursor: pointer;">
                                                    Delete
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            <% }); %>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>

    </section>
    <% } %>

    <!-- 3. ORDER AND FULFILLMENT MANAGEMENT TAB -->
    <% if (activeTab === 'orders') { %>
    <section class="admin-section-block">
        <!-- Fulfillment Pipeline Summary -->
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); gap: 14px; margin-bottom: 24px;">
            <div class="status-pill-card status-pending" style="background: #fefce8; border: 1px solid #fef08a; padding: 14px; border-radius: 10px;">
                <span class="status-count" style="font-size: 1.5rem; font-weight: 800; color: #a16207;"><%= stats.fulfillmentQueue.pending %></span>
                <span class="status-label" style="font-size: 12px; font-weight: 700; color: #854d0e; display: block;">Pending</span>
            </div>
            <div class="status-pill-card status-processing" style="background: #eff6ff; border: 1px solid #bfdbfe; padding: 14px; border-radius: 10px;">
                <span class="status-count" style="font-size: 1.5rem; font-weight: 800; color: #1d4ed8;"><%= stats.fulfillmentQueue.processing %></span>
                <span class="status-label" style="font-size: 12px; font-weight: 700; color: #1e40af; display: block;">Processing</span>
            </div>
            <div class="status-pill-card status-shipped" style="background: #faf5ff; border: 1px solid #e9d5ff; padding: 14px; border-radius: 10px;">
                <span class="status-count" style="font-size: 1.5rem; font-weight: 800; color: #7e22ce;"><%= stats.fulfillmentQueue.shipped %></span>
                <span class="status-label" style="font-size: 12px; font-weight: 700; color: #6b21a8; display: block;">In Transit</span>
            </div>
            <div class="status-pill-card status-delivered" style="background: #f0fdf4; border: 1px solid #bbf7d0; padding: 14px; border-radius: 10px;">
                <span class="status-count" style="font-size: 1.5rem; font-weight: 800; color: #15803d;"><%= stats.fulfillmentQueue.delivered %></span>
                <span class="status-label" style="font-size: 12px; font-weight: 700; color: #166534; display: block;">Delivered</span>
            </div>
            <div class="status-pill-card status-cancelled" style="background: #fef2f2; border: 1px solid #fecaca; padding: 14px; border-radius: 10px;">
                <span class="status-count" style="font-size: 1.5rem; font-weight: 800; color: #dc2626;"><%= stats.fulfillmentQueue.cancelled %></span>
                <span class="status-label" style="font-size: 12px; font-weight: 700; color: #991b1b; display: block;">Cancelled</span>
            </div>
        </div>

        <!-- Recent Orders Table -->
        <div class="admin-card" style="background: #ffffff; border: 1px solid #e2e8f0; border-radius: 16px; padding: 24px; box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);">
            <h3 class="admin-card-title" style="margin: 0 0 16px; font-size: 1.2rem; font-weight: 800; color: #0f172a;">
                📦 Order Fulfillment & Dispatch Manager
            </h3>
            <div class="table-responsive">
                <table class="admin-table" style="width: 100%; border-collapse: collapse;">
                    <thead>
                        <tr style="background: #f8fafc; border-bottom: 2px solid #e2e8f0; text-align: left;">
                            <th style="padding: 12px; font-size: 12px; font-weight: 700; color: #475569;">Order ID</th>
                            <th style="padding: 12px; font-size: 12px; font-weight: 700; color: #475569;">Customer & Destination</th>
                            <th style="padding: 12px; font-size: 12px; font-weight: 700; color: #475569;">WhatsApp / Phone</th>
                            <th style="padding: 12px; font-size: 12px; font-weight: 700; color: #475569;">Total (UGX)</th>
                            <th style="padding: 12px; font-size: 12px; font-weight: 700; color: #475569;">Current Status</th>
                            <th style="padding: 12px; font-size: 12px; font-weight: 700; color: #475569;">Update Status</th>
                            <th style="padding: 12px; font-size: 12px; font-weight: 700; color: #475569;">Contact</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (!stats.fulfillmentQueue.recentOrders || stats.fulfillmentQueue.recentOrders.length === 0) { %>
                            <tr><td colspan="7" style="text-align: center; padding: 32px; color: #64748b;">No customer orders placed yet.</td></tr>
                        <% } else { %>
                            <% stats.fulfillmentQueue.recentOrders.forEach(function(o) { %>
                                <tr style="border-bottom: 1px solid #f1f5f9;">
                                    <td style="padding: 12px;"><strong>#<%= o.id %></strong></td>
                                    <td style="padding: 12px;">
                                        <div style="font-weight: 700;"><%= o.user_name %></div>
                                        <div style="font-size: 11px; color: #64748b;"><%= o.address %></div>
                                    </td>
                                    <td style="padding: 12px;">
                                        <% if (o.whatsapp_number) { %>
                                            <a href="https://wa.me/<%= db.sanitizeWhatsAppNumber(o.whatsapp_number) %>?text=<%= encodeURIComponent(`Hello ${o.user_name}, this is EasyMarket Dispatch regarding your Order #${o.id}.`) %>" target="_blank" class="btn-whatsapp-sm" style="color: #16a34a; font-size: 12px; font-weight: 600; text-decoration: none;">
                                                💬 <%= o.whatsapp_number %>
                                            </a>
                                        <% } else { %>
                                            <span><%= o.phone %></span>
                                        <% } %>
                                    </td>
                                    <td style="padding: 12px; font-weight: 700;">UGX <%= Number(o.total).toLocaleString() %></td>
                                    <td style="padding: 12px;">
                                        <span class="badge-tag" style="
                                            background: <%= o.status === 'Delivered' ? '#dcfce7' : (o.status === 'Cancelled' ? '#fee2e2' : '#fef3c7') %>;
                                            color: <%= o.status === 'Delivered' ? '#166534' : (o.status === 'Cancelled' ? '#991b1b' : '#92400e') %>;
                                            padding: 3px 8px; border-radius: 6px; font-size: 11px; font-weight: 700;">
                                            <%= o.status %>
                                        </span>
                                    </td>
                                    <td style="padding: 12px;">
                                        <form method="POST" action="/admin_dashboard/order-status" style="display: flex; gap: 6px;">
                                            <input type="hidden" name="order_id" value="<%= o.id %>">
                                            <select name="status" style="padding: 5px 8px; font-size: 12px; border-radius: 6px; border: 1px solid #cbd5e1;">
                                                <option value="Pending" <%= o.status === 'Pending' ? 'selected' : '' %>>Pending</option>
                                                <option value="Processing" <%= o.status === 'Processing' ? 'selected' : '' %>>Processing</option>
                                                <option value="Shipped" <%= o.status === 'Shipped' ? 'selected' : '' %>>Shipped</option>
                                                <option value="Delivered" <%= o.status === 'Delivered' ? 'selected' : '' %>>Delivered</option>
                                                <option value="Cancelled" <%= o.status === 'Cancelled' ? 'selected' : '' %>>Cancelled</option>
                                            </select>
                                            <button type="submit" class="btn-sm-action" style="background: #2563eb; color: white; border: none; padding: 5px 10px; border-radius: 6px; font-size: 11px; font-weight: 600; cursor: pointer;">Update</button>
                                        </form>
                                    </td>
                                    <td style="padding: 12px;">
                                        <a href="/messages?to=<%= o.user_id %>" class="btn-inapp-msg" style="padding: 4px 8px; font-size: 11px; text-decoration: none;">
                                            ✉️ Chat Buyer
                                        </a>
                                    </td>
                                </tr>
                            <% }); %>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Returns and Refunds Management -->
        <div class="admin-card" style="margin-top: 24px; background: #ffffff; border: 1px solid #e2e8f0; border-radius: 16px; padding: 24px; box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);">
            <h3 class="admin-card-title" style="margin: 0 0 16px; font-size: 1.2rem; font-weight: 800; color: #0f172a;">
                🔄 Returns & Refunds Requests (<%= stats.returns.total %> Requests)
            </h3>
            <div class="table-responsive">
                <table class="admin-table" style="width: 100%; border-collapse: collapse;">
                    <thead>
                        <tr style="background: #f8fafc; border-bottom: 2px solid #e2e8f0; text-align: left;">
                            <th style="padding: 12px; font-size: 12px; font-weight: 700; color: #475569;">Return ID</th>
                            <th style="padding: 12px; font-size: 12px; font-weight: 700; color: #475569;">Order Ref</th>
                            <th style="padding: 12px; font-size: 12px; font-weight: 700; color: #475569;">Customer</th>
                            <th style="padding: 12px; font-size: 12px; font-weight: 700; color: #475569;">Reason</th>
                            <th style="padding: 12px; font-size: 12px; font-weight: 700; color: #475569;">Claim Amount</th>
                            <th style="padding: 12px; font-size: 12px; font-weight: 700; color: #475569;">Status</th>
                            <th style="padding: 12px; font-size: 12px; font-weight: 700; color: #475569;">Process Refund</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (!stats.returns.items || stats.returns.items.length === 0) { %>
                            <tr><td colspan="7" style="text-align: center; padding: 32px; color: #64748b;">No refund or return requests on file.</td></tr>
                        <% } else { %>
                            <% stats.returns.items.forEach(function(r) { %>
                                <tr style="border-bottom: 1px solid #f1f5f9;">
                                    <td style="padding: 12px;">#<%= r.id %></td>
                                    <td style="padding: 12px;">Order #<%= r.order_id %></td>
                                    <td style="padding: 12px;">
                                        <strong><%= r.user_name %></strong>
                                        <% if (r.whatsapp_number) { %>
                                            <a href="https://wa.me/<%= db.sanitizeWhatsAppNumber(r.whatsapp_number) %>" target="_blank" style="color: #16a34a; font-size: 11px; display: block; text-decoration: none;">
                                                💬 WhatsApp
                                            </a>
                                        <% } %>
                                    </td>
                                    <td style="padding: 12px;"><span style="font-size: 12px; color: #334155;"><%= r.reason %></span></td>
                                    <td style="padding: 12px; font-weight: 700;">UGX <%= Number(r.amount).toLocaleString() %></td>
                                    <td style="padding: 12px;">
                                        <span class="badge-tag" style="
                                            background: <%= r.status === 'Approved' ? '#dcfce7' : (r.status === 'Rejected' ? '#fee2e2' : '#fef3c7') %>;
                                            color: <%= r.status === 'Approved' ? '#166534' : (r.status === 'Rejected' ? '#991b1b' : '#92400e') %>;
                                            padding: 3px 8px; border-radius: 6px; font-size: 11px; font-weight: 700;">
                                            <%= r.status %>
                                        </span>
                                    </td>
                                    <td style="padding: 12px;">
                                        <!-- Absolute form action to prevent double path errors -->
                                        <form method="POST" action="/admin_dashboard/return-status" style="display: flex; gap: 6px; align-items: center;">
                                            <input type="hidden" name="return_id" value="<%= r.id %>">
                                            <input type="text" name="admin_note" placeholder="Admin note" style="padding: 5px 8px; font-size: 11px; width: 110px; border-radius: 6px; border: 1px solid #cbd5e1;">
                                            <button type="submit" name="status" value="Approved" style="background: #16a34a; color: white; border: none; padding: 5px 10px; border-radius: 6px; font-size: 11px; font-weight: 600; cursor: pointer;">Approve</button>
                                            <button type="submit" name="status" value="Rejected" style="background: #dc2626; color: white; border: none; padding: 5px 10px; border-radius: 6px; font-size: 11px; font-weight: 600; cursor: pointer;">Reject</button>
                                        </form>
                                    </td>
                                </tr>
                            <% }); %>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>
    </section>
    <% } %>

    <!-- 4. CUSTOMER INSIGHTS TAB -->
    <% if (activeTab === 'customers') { %>
    <section class="admin-section-block">
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 16px; margin-bottom: 24px;">
            <div class="metric-card" style="background: #ffffff; border: 1px solid #e2e8f0; border-radius: 12px; padding: 18px;">
                <div class="metric-label" style="font-size: 12px; color: #64748b; font-weight: 700;">New First-Time Buyers</div>
                <div class="metric-val" style="color: #2563eb; font-size: 1.6rem; font-weight: 800; margin: 4px 0;"><%= stats.customerInsights.newBuyers %></div>
                <div class="metric-sub" style="font-size: 11px; color: #64748b;">Single order placed</div>
            </div>
            <div class="metric-card" style="background: #ffffff; border: 1px solid #e2e8f0; border-radius: 12px; padding: 18px;">
                <div class="metric-label" style="font-size: 12px; color: #64748b; font-weight: 700;">Repeat / Returning Buyers</div>
                <div class="metric-val" style="color: #16a34a; font-size: 1.6rem; font-weight: 800; margin: 4px 0;"><%= stats.customerInsights.returningBuyers %></div>
                <div class="metric-sub" style="font-size: 11px; color: #16a34a; font-weight: 600;">High retention customers</div>
            </div>
            <div class="metric-card" style="background: #ffffff; border: 1px solid #e2e8f0; border-radius: 12px; padding: 18px;">
                <div class="metric-label" style="font-size: 12px; color: #64748b; font-weight: 700;">Open Support Tickets</div>
                <div class="metric-val" style="color: #ea580c; font-size: 1.6rem; font-weight: 800; margin: 4px 0;"><%= stats.customerInsights.openTicketsCount %></div>
                <div class="metric-sub" style="font-size: 11px; color: #ea580c;">Pending resolution</div>
            </div>
        </div>

        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(340px, 1fr)); gap: 24px;">
            <!-- Support Tickets Queue -->
            <div class="admin-card" style="background: #ffffff; border: 1px solid #e2e8f0; border-radius: 16px; padding: 22px; box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);">
                <h3 class="admin-card-title" style="margin: 0 0 16px; font-size: 1.15rem; font-weight: 800; color: #0f172a;">
                    🎧 Customer Support Tickets
                </h3>
                <% if (!stats.customerInsights.supportTickets || stats.customerInsights.supportTickets.length === 0) { %>
                    <p style="color: #64748b; font-size: 13px;">No tickets currently on file.</p>
                <% } else { %>
                    <div style="display: flex; flex-direction: column; gap: 14px;">
                        <% stats.customerInsights.supportTickets.forEach(function(t) { %>
                            <div style="background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 10px; padding: 14px;">
                                <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 6px;">
                                    <div>
                                        <strong style="font-size: 14px;"><%= t.subject %></strong>
                                        <div style="font-size: 11px; color: #64748b;">From: <%= t.user_name %> (<%= t.user_email %>)</div>
                                    </div>
                                    <span class="badge-tag" style="background: <%= t.status === 'Resolved' ? '#dcfce7' : '#fef3c7' %>; color: <%= t.status === 'Resolved' ? '#166534' : '#92400e' %>; padding: 2px 6px; border-radius: 4px; font-size: 11px; font-weight: 700;">
                                        <%= t.status %>
                                    </span>
                                </div>
                                <p style="font-size: 13px; color: #334155; margin: 0 0 10px;"><%= t.message %></p>
                                
                                <% if (t.admin_reply) { %>
                                    <div style="background: white; border-left: 3px solid #6366f1; padding: 8px; border-radius: 4px; font-size: 12px; margin-bottom: 10px;">
                                        <strong>Past Reply:</strong> <%= t.admin_reply %>
                                    </div>
                                <% } %>

                                <!-- Reply Form -->
                                <form method="POST" action="/admin_dashboard/reply-ticket" style="display: flex; gap: 8px;">
                                    <input type="hidden" name="ticket_id" value="<%= t.id %>">
                                    <input type="text" name="reply" placeholder="Type resolution or reply..." style="flex: 1; padding: 6px 10px; font-size: 12px; border-radius: 6px; border: 1px solid #cbd5e1;" required>
                                    <button type="submit" class="btn-primary" style="padding: 6px 12px; font-size: 12px; font-weight: 600;">Reply & Resolve</button>
                                </form>
                            </div>
                        <% }); %>
                    </div>
                <% } %>
            </div>

            <!-- Top Buyers Leaderboard -->
            <div class="admin-card" style="background: #ffffff; border: 1px solid #e2e8f0; border-radius: 16px; padding: 22px; box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);">
                <h3 class="admin-card-title" style="margin: 0 0 16px; font-size: 1.15rem; font-weight: 800; color: #0f172a;">
                    🏆 Top Buyers by Total Spend
                </h3>
                <% if (!stats.customerInsights.topBuyers || stats.customerInsights.topBuyers.length === 0) { %>
                    <p style="color: #64748b; font-size: 13px;">No buyer spend data yet.</p>
                <% } else { %>
                    <div style="display: flex; flex-direction: column; gap: 10px;">
                        <% stats.customerInsights.topBuyers.forEach(function(b, idx) { %>
                            <div style="display: flex; justify-content: space-between; align-items: center; background: #f8fafc; padding: 12px; border-radius: 8px; border: 1px solid #e2e8f0;">
                                <div style="display: flex; align-items: center; gap: 10px;">
                                    <div class="conv-avatar" style="width: 32px; height: 32px; font-size: 13px; font-weight: 700; background: #eff6ff; color: #2563eb; display: flex; align-items: center; justify-content: center; border-radius: 50%;">
                                        #<%= idx + 1 %>
                                    </div>
                                    <div>
                                        <strong style="font-size: 13px;"><%= b.userName %></strong>
                                        <div style="font-size: 11px; color: #64748b;"><%= b.orderCount %> order(s) placed</div>
                                    </div>
                                </div>
                                <div style="text-align: right;">
                                    <div style="font-weight: 800; color: #166534; font-size: 13px;">
                                        UGX <%= Number(b.totalSpent).toLocaleString() %>
                                    </div>
                                    <% if (b.whatsapp) { %>
                                        <a href="https://wa.me/<%= db.sanitizeWhatsAppNumber(b.whatsapp) %>" target="_blank" style="color: #16a34a; font-size: 11px; font-weight: 600; text-decoration: none;">
                                            💬 WhatsApp
                                        </a>
                                    <% } %>
                                </div>
                            </div>
                        <% }); %>
                    </div>
                <% } %>
            </div>
        </div>
    </section>
    <% } %>

    <!-- 5. MARKETING AND PROMOTIONS TAB -->
    <% if (activeTab === 'marketing') { %>
    <section class="admin-section-block">
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(340px, 1fr)); gap: 24px;">
            <!-- Active Campaigns -->
            <div class="admin-card" style="background: #ffffff; border: 1px solid #e2e8f0; border-radius: 16px; padding: 22px; box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);">
                <h3 class="admin-card-title" style="margin: 0 0 16px; font-size: 1.15rem; font-weight: 800; color: #0f172a;">
                    📢 Active Promotions & Discount Codes
                </h3>
                <div class="table-responsive">
                    <table class="admin-table" style="width: 100%; border-collapse: collapse;">
                        <thead>
                            <tr style="background: #f8fafc; border-bottom: 2px solid #e2e8f0; text-align: left;">
                                <th style="padding: 10px; font-size: 12px; font-weight: 700; color: #475569;">Campaign</th>
                                <th style="padding: 10px; font-size: 12px; font-weight: 700; color: #475569;">Promo Code</th>
                                <th style="padding: 10px; font-size: 12px; font-weight: 700; color: #475569;">Discount</th>
                                <th style="padding: 10px; font-size: 12px; font-weight: 700; color: #475569;">Orders</th>
                                <th style="padding: 10px; font-size: 12px; font-weight: 700; color: #475569;">Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (!stats.marketing.campaigns || stats.marketing.campaigns.length === 0) { %>
                                <tr><td colspan="5" style="text-align: center; padding: 24px; color: #64748b;">No promotional campaigns active.</td></tr>
                            <% } else { %>
                                <% stats.marketing.campaigns.forEach(function(c) { %>
                                    <tr style="border-bottom: 1px solid #f1f5f9;">
                                        <td style="padding: 10px;"><strong><%= c.name %></strong></td>
                                        <td style="padding: 10px;"><code style="background: #f1f5f9; padding: 2px 6px; border-radius: 4px;"><%= c.code %></code></td>
                                        <td style="padding: 10px; font-weight: 700; color: #166534;"><%= c.discount_percent %>% OFF</td>
                                        <td style="padding: 10px;"><strong><%= c.conversions %></strong></td>
                                        <td style="padding: 10px;"><span class="badge-tag" style="background: #dcfce7; color: #166534; padding: 2px 6px; border-radius: 4px; font-size: 11px;"><%= c.status %></span></td>
                                    </tr>
                                <% }); %>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Traffic Sources Breakdown -->
            <div class="admin-card" style="background: #ffffff; border: 1px solid #e2e8f0; border-radius: 16px; padding: 22px; box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);">
                <h3 class="admin-card-title" style="margin: 0 0 16px; font-size: 1.15rem; font-weight: 800; color: #0f172a;">
                    🌐 Traffic & Shopper Acquisition Channels
                </h3>
                <div style="flex-direction: column; display: flex; gap: 16px;">
                    <% stats.marketing.trafficSources.forEach(function(ts) { %>
                        <div>
                            <div style="display: flex; justify-content: space-between; font-size: 13px; margin-bottom: 4px;">
                                <span><%= ts.source %></span>
                                <strong><%= ts.percentage %>%</strong>
                            </div>
                            <div style="background: #e2e8f0; height: 8px; border-radius: 4px; overflow: hidden;">
                                <div style="background: <%= ts.color %>; width: <%= ts.percentage %>%; height: 100%;"></div>
                            </div>
                        </div>
                    <% }); %>
                </div>
            </div>
        </div>
    </section>
    <% } %>
</main>
</body>
</html>
