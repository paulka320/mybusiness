<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Command Center | EasyMarket Uganda</title>
    <link rel="stylesheet" href="style.css">
    <script src="script.js" defer></script>
</head>
<body style="background: #f8fafc;">
<%- include('header') %>

<main class="section" style="max-width: 1240px; padding: 24px 20px;">
    <!-- Admin Top Banner -->
    <div class="admin-header-banner">
        <div>
            <div style="display: flex; align-items: center; gap: 8px;">
                <span style="font-size: 24px;">⚡</span>
                <h1 style="margin: 0; font-size: 1.8rem; color: #0f172a;">EasyMarket Admin Command Suite</h1>
            </div>
            <p style="margin: 6px 0 0; color: #64748b; font-size: 14px;">
                Comprehensive analytics, order fulfillment, inventory alarms, customer insights & marketplace management.
            </p>
        </div>
        <div style="display: flex; align-items: center; gap: 12px; flex-wrap: wrap;">
            <a href="upload.php" class="btn-primary" style="padding: 10px 18px; font-size: 13px;">➕ Add Product</a>
            <a href="logout.php" id="admin-page-logout-btn" class="nav-logout-btn" style="padding: 10px 18px; font-size: 13px; text-decoration: none;">
                🚪 Logout Admin
            </a>
        </div>
    </div>

    <!-- Navigation Tabs -->
    <div class="admin-tab-nav" id="admin-tabs">
        <a href="admin_dashboard.php?tab=overview" class="admin-tab-btn <%= (!locals.activeTab || activeTab === 'overview') ? 'active' : '' %>">
            📈 Core Analytics
        </a>
        <a href="admin_dashboard.php?tab=orders" class="admin-tab-btn <%= (activeTab === 'orders') ? 'active' : '' %>">
            🚚 Orders & Fulfillment
            <% if (stats.fulfillmentQueue.pending > 0) { %>
                <span class="tab-badge-orange"><%= stats.fulfillmentQueue.pending %></span>
            <% } %>
        </a>
        <a href="admin_dashboard.php?tab=inventory" class="admin-tab-btn <%= (activeTab === 'inventory') ? 'active' : '' %>">
            📦 Inventory & Catalog
            <% if (stats.inventory.lowStock.length > 0) { %>
                <span class="tab-badge-red"><%= stats.inventory.lowStock.length %> low</span>
            <% } %>
        </a>
        <a href="admin_dashboard.php?tab=customers" class="admin-tab-btn <%= (activeTab === 'customers') ? 'active' : '' %>">
            👥 Customer Insights & Tickets
            <% if (stats.customerInsights.openTicketsCount > 0) { %>
                <span class="tab-badge-orange"><%= stats.customerInsights.openTicketsCount %></span>
            <% } %>
        </a>
        <a href="admin_dashboard.php?tab=marketing" class="admin-tab-btn <%= (activeTab === 'marketing') ? 'active' : '' %>">
            📢 Marketing & Traffic
        </a>
    </div>

    <!-- 1. CORE METRICS & ANALYTICS TAB -->
    <% if (!locals.activeTab || activeTab === 'overview') { %>
    <section class="admin-section-block">
        <div class="metrics-grid">
            <!-- Total Sales -->
            <div class="metric-card">
                <div class="metric-label">Total Marketplace Gross Sales</div>
                <div class="metric-val" style="color: #0f172a;">
                    UGX <%= Number(stats.core.totalGrossSales || 0).toLocaleString() %>
                </div>
                <div class="metric-sub text-green">
                    <span>▲ +18.4% this month</span>
                </div>
            </div>

            <!-- Order Count -->
            <div class="metric-card">
                <div class="metric-label">Total Order Count</div>
                <div class="metric-val" style="color: #2563eb;">
                    <%= stats.core.totalOrders || 0 %>
                </div>
                <div class="metric-sub" style="color: #64748b;">
                    <span><%= stats.fulfillmentQueue.delivered || 0 %> Delivered · <%= stats.fulfillmentQueue.pending || 0 %> Pending</span>
                </div>
            </div>

            <!-- Average Order Value (AOV) -->
            <div class="metric-card">
                <div class="metric-label">Average Order Value (AOV)</div>
                <div class="metric-val" style="color: #d97706;">
                    UGX <%= Number(Math.round(stats.core.averageOrderValue || 0)).toLocaleString() %>
                </div>
                <div class="metric-sub" style="color: #64748b;">
                    <span>Per successful customer checkout</span>
                </div>
            </div>

            <!-- Conversion Rate -->
            <div class="metric-card">
                <div class="metric-label">Store Conversion Rate</div>
                <div class="metric-val" style="color: #16a34a;">
                    <%= stats.core.conversionRate %>%
                </div>
                <div class="metric-sub" style="color: #64748b;">
                    <span>From ~<%= stats.core.estimatedVisitors.toLocaleString() %> shopping visitors</span>
                </div>
            </div>
        </div>

        <!-- Secondary Summary Grid -->
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 20px; margin-top: 24px;">
            <!-- System Health & Security Status -->
            <div class="admin-card">
                <h3 class="admin-card-title">🛡️ System Security & Anti-Fraud Shield</h3>
                <div class="info-list">
                    <div class="info-row">
                        <span>Anti-Deception Policy:</span>
                        <strong class="text-green">Enforced (10-Point Agreement Active)</strong>
                    </div>
                    <div class="info-row">
                        <span>Database Architecture:</span>
                        <strong class="text-green">PostgreSQL / Supabase Ready</strong>
                    </div>
                    <div class="info-row">
                        <span>Fraud & Scam Protection:</span>
                        <strong class="text-green">Active (Multi-Angle Photo Auditing)</strong>
                    </div>
                    <div class="info-row">
                        <span>Brute-force Rate Limiting:</span>
                        <strong class="text-green">Active (IP Throttling Enabled)</strong>
                    </div>
                </div>
            </div>

            <!-- Fast Inventory Snapshot -->
            <div class="admin-card">
                <h3 class="admin-card-title">📦 Inventory Health Overview</h3>
                <div class="info-list">
                    <div class="info-row">
                        <span>Total Catalog Items:</span>
                        <strong><%= stats.inventory.totalProducts %> Products</strong>
                    </div>
                    <div class="info-row">
                        <span>Total Inventory Units:</span>
                        <strong><%= stats.inventory.totalStockUnits %> Units</strong>
                    </div>
                    <div class="info-row">
                        <span>Total Inventory Valuation:</span>
                        <strong style="color: #ff5e62;">UGX <%= Number(stats.inventory.totalInventoryValue).toLocaleString() %></strong>
                    </div>
                    <div class="info-row">
                        <span>Low Stock / Out of Stock:</span>
                        <strong style="color: <%= stats.inventory.lowStock.length > 0 ? '#ea580c' : '#16a34a' %>;">
                            <%= stats.inventory.lowStock.length %> low / <%= stats.inventory.outOfStock.length %> out
                        </strong>
                    </div>
                </div>
            </div>
        </div>
    </section>
    <% } %>

    <!-- 2. ORDER AND FULFILLMENT MANAGEMENT TAB -->
    <% if (activeTab === 'orders') { %>
    <section class="admin-section-block">
        <!-- Fulfillment Pipeline Summary -->
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); gap: 14px; margin-bottom: 24px;">
            <div class="status-pill-card status-pending">
                <span class="status-count"><%= stats.fulfillmentQueue.pending %></span>
                <span class="status-label">Pending</span>
            </div>
            <div class="status-pill-card status-processing">
                <span class="status-count"><%= stats.fulfillmentQueue.processing %></span>
                <span class="status-label">Processing</span>
            </div>
            <div class="status-pill-card status-shipped">
                <span class="status-count"><%= stats.fulfillmentQueue.shipped %></span>
                <span class="status-label">In Transit</span>
            </div>
            <div class="status-pill-card status-delivered">
                <span class="status-count"><%= stats.fulfillmentQueue.delivered %></span>
                <span class="status-label">Delivered</span>
            </div>
            <div class="status-pill-card status-cancelled">
                <span class="status-count"><%= stats.fulfillmentQueue.cancelled %></span>
                <span class="status-label">Cancelled</span>
            </div>
        </div>

        <!-- Recent Orders Table with Instant Status Updater -->
        <div class="admin-card">
            <h3 class="admin-card-title">📦 Order & Fulfillment Management</h3>
            <div class="table-responsive">
                <table class="admin-table">
                    <thead>
                        <tr>
                            <th>Order ID</th>
                            <th>Customer</th>
                            <th>WhatsApp / Phone</th>
                            <th>Total (UGX)</th>
                            <th>Current Status</th>
                            <th>Update Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (stats.fulfillmentQueue.recentOrders.length === 0) { %>
                            <tr><td colspan="7" style="text-align: center; color: #64748b;">No orders placed yet.</td></tr>
                        <% } else { %>
                            <% stats.fulfillmentQueue.recentOrders.forEach(function(o) { %>
                                <tr>
                                    <td><strong>#<%= o.id %></strong></td>
                                    <td>
                                        <div><strong><%= o.user_name %></strong></div>
                                        <div style="font-size: 11px; color: #64748b;"><%= o.address %></div>
                                    </td>
                                    <td>
                                        <% if (o.whatsapp_number) { %>
                                            <a href="https://wa.me/<%= db.sanitizeWhatsAppNumber(o.whatsapp_number) %>?text=<%= encodeURIComponent(`Hello ${o.user_name}, this is EasyMarket Dispatch regarding your Order #${o.id}.`) %>" target="_blank" class="btn-whatsapp-sm" style="display: inline-flex;">
                                                💬 <%= o.whatsapp_number %>
                                            </a>
                                        <% } else { %>
                                            <span><%= o.phone %></span>
                                        <% } %>
                                    </td>
                                    <td><strong>UGX <%= Number(o.total).toLocaleString() %></strong></td>
                                    <td>
                                        <span class="badge-tag" style="
                                            background: <%= o.status === 'Delivered' ? '#dcfce7' : (o.status === 'Cancelled' ? '#fee2e2' : '#fef3c7') %>;
                                            color: <%= o.status === 'Delivered' ? '#166534' : (o.status === 'Cancelled' ? '#991b1b' : '#92400e') %>;">
                                            <%= o.status %>
                                        </span>
                                    </td>
                                    <td>
                                        <form method="POST" action="admin_dashboard.php/order-status" style="display: flex; gap: 6px;">
                                            <input type="hidden" name="order_id" value="<%= o.id %>">
                                            <select name="status" style="padding: 6px; font-size: 12px; border-radius: 6px; border: 1px solid #cbd5e1;">
                                                <option value="Pending" <%= o.status === 'Pending' ? 'selected' : '' %>>Pending</option>
                                                <option value="Processing" <%= o.status === 'Processing' ? 'selected' : '' %>>Processing</option>
                                                <option value="Shipped" <%= o.status === 'Shipped' ? 'selected' : '' %>>Shipped</option>
                                                <option value="Delivered" <%= o.status === 'Delivered' ? 'selected' : '' %>>Delivered</option>
                                                <option value="Cancelled" <%= o.status === 'Cancelled' ? 'selected' : '' %>>Cancelled</option>
                                            </select>
                                            <button type="submit" class="btn-sm-action">Update</button>
                                        </form>
                                    </td>
                                    <td>
                                        <a href="messages.php?to=<%= o.user_id %>" class="btn-inapp-msg" style="padding: 4px 8px; font-size: 11px;">
                                            ✉️ Chat Buyer
                                        </a>
                                    </td>
                                </tr>
                            <% }); %>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Returns and Refunds Management -->
        <div class="admin-card" style="margin-top: 24px;">
            <h3 class="admin-card-title">🔄 Returns and Refunds Management (<%= stats.returns.total %> Requests)</h3>
            <div class="table-responsive">
                <table class="admin-table">
                    <thead>
                        <tr>
                            <th>Return ID</th>
                            <th>Order Ref</th>
                            <th>Customer</th>
                            <th>Reason</th>
                            <th>Claim Amount</th>
                            <th>Status</th>
                            <th>Process Refund</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (stats.returns.items.length === 0) { %>
                            <tr><td colspan="7" style="text-align: center; color: #64748b;">No refund or return requests on file.</td></tr>
                        <% } else { %>
                            <% stats.returns.items.forEach(function(r) { %>
                                <tr>
                                    <td>#<%= r.id %></td>
                                    <td>Order #<%= r.order_id %></td>
                                    <td>
                                        <strong><%= r.user_name %></strong>
                                        <% if (r.whatsapp_number) { %>
                                            <a href="https://wa.me/<%= db.sanitizeWhatsAppNumber(r.whatsapp_number) %>" target="_blank" style="color: #16a34a; font-size: 11px; display: block;">
                                                💬 WhatsApp
                                            </a>
                                        <% } %>
                                    </td>
                                    <td><span style="font-size: 12px; color: #334155;"><%= r.reason %></span></td>
                                    <td><strong>UGX <%= Number(r.amount).toLocaleString() %></strong></td>
                                    <td>
                                        <span class="badge-tag" style="
                                            background: <%= r.status === 'Approved' ? '#dcfce7' : (r.status === 'Rejected' ? '#fee2e2' : '#fef3c7') %>;
                                            color: <%= r.status === 'Approved' ? '#166534' : (r.status === 'Rejected' ? '#991b1b' : '#92400e') %>;">
                                            <%= r.status %>
                                        </span>
                                    </td>
                                    <td>
                                        <form method="POST" action="admin_dashboard.php/return-status" style="display: flex; gap: 6px; align-items: center;">
                                            <input type="hidden" name="return_id" value="<%= r.id %>">
                                            <input type="text" name="admin_note" placeholder="Admin note" style="padding: 4px 8px; font-size: 11px; width: 110px; border-radius: 4px; border: 1px solid #cbd5e1;">
                                            <button type="submit" name="status" value="Approved" style="background: #16a34a; color: white; border: none; padding: 4px 8px; border-radius: 4px; font-size: 11px; cursor: pointer;">Approve</button>
                                            <button type="submit" name="status" value="Rejected" style="background: #dc2626; color: white; border: none; padding: 4px 8px; border-radius: 4px; font-size: 11px; cursor: pointer;">Reject</button>
                                        </form>
                                    </td>
                                </tr>
                            <% }); %>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>
    </section>
    <% } %>

    <!-- 3. INVENTORY AND CATALOG CONTROL TAB -->
    <% if (activeTab === 'inventory') { %>
    <section class="admin-section-block">
        <!-- Low Stock Alerts & Out-of-Stock Warnings -->
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-bottom: 24px;">
            <!-- Low Stock Alarm (< 4 units) -->
            <div class="admin-card" style="border-left: 4px solid #ea580c;">
                <h3 class="admin-card-title" style="color: #c2410c;">⚠️ Low Stock Alerts (Threshold ≤ 3 units)</h3>
                <% if (stats.inventory.lowStock.length === 0) { %>
                    <p style="color: #16a34a; font-size: 13px; margin: 0;">✓ All active inventory is adequately stocked.</p>
                <% } else { %>
                    <div style="display: flex; flex-direction: column; gap: 8px;">
                        <% stats.inventory.lowStock.forEach(function(item) { %>
                            <div style="display: flex; justify-content: space-between; align-items: center; background: #fff7ed; padding: 8px 12px; border-radius: 6px;">
                                <div>
                                    <strong style="font-size: 13px;"><%= item.title %></strong>
                                    <div style="font-size: 11px; color: #9a3412;">Only <%= item.quantity %> units remaining!</div>
                                </div>
                                <form method="POST" action="admin_dashboard.php" style="display: flex; gap: 6px;">
                                    <input type="hidden" name="product_id" value="<%= item.id %>">
                                    <input type="number" name="quantity" value="10" min="1" style="width: 50px; padding: 4px; font-size: 11px;">
                                    <button type="submit" name="update_quantity" value="1" class="btn-sm-action">Restock</button>
                                </form>
                            </div>
                        <% }); %>
                    </div>
                <% } %>
            </div>

            <!-- Out of Stock Alarm -->
            <div class="admin-card" style="border-left: 4px solid #dc2626;">
                <h3 class="admin-card-title" style="color: #b91c1c;">🚫 Out-of-Stock List</h3>
                <% if (stats.inventory.outOfStock.length === 0) { %>
                    <p style="color: #16a34a; font-size: 13px; margin: 0;">✓ No products are currently out of stock.</p>
                <% } else { %>
                    <div style="display: flex; flex-direction: column; gap: 8px;">
                        <% stats.inventory.outOfStock.forEach(function(item) { %>
                            <div style="display: flex; justify-content: space-between; align-items: center; background: #fef2f2; padding: 8px 12px; border-radius: 6px;">
                                <div>
                                    <strong style="font-size: 13px;"><%= item.title %></strong>
                                    <div style="font-size: 11px; color: #991b1b;">0 units (Hidden from buyers)</div>
                                </div>
                                <form method="POST" action="admin_dashboard.php" style="display: flex; gap: 6px;">
                                    <input type="hidden" name="product_id" value="<%= item.id %>">
                                    <input type="number" name="quantity" value="5" min="1" style="width: 50px; padding: 4px; font-size: 11px;">
                                    <button type="submit" name="update_quantity" value="1" class="btn-sm-action">Add Stock</button>
                                </form>
                            </div>
                        <% }); %>
                    </div>
                <% } %>
            </div>
        </div>

        <!-- Catalog Quick Edit Master Table -->
        <div class="admin-card">
            <h3 class="admin-card-title">📝 Product Quick Edit & Catalog Control</h3>
            <div class="table-responsive">
                <table class="admin-table">
                    <thead>
                        <tr>
                            <th>Preview</th>
                            <th>Title</th>
                            <th>Category</th>
                            <th>Price (UGX)</th>
                            <th>Stock Qty</th>
                            <th>Status</th>
                            <th>Quick Save</th>
                            <th>Delete</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% products.forEach(function(p) { %>
                            <tr>
                                <td>
                                    <img src="uploads/<%= p.image %>" alt="<%= p.title %>" style="width: 44px; height: 44px; object-fit: cover; border-radius: 6px;">
                                </td>
                                <td>
                                    <input type="text" form="quick-edit-<%= p.id %>" name="title" value="<%= p.title %>" style="font-size: 12px; padding: 4px 8px; width: 180px;">
                                </td>
                                <td><span class="badge-tag"><%= p.category_name || 'General' %></span></td>
                                <td>
                                    <input type="number" form="quick-edit-<%= p.id %>" name="price" value="<%= p.price %>" step="100" style="font-size: 12px; padding: 4px 8px; width: 110px;">
                                </td>
                                <td>
                                    <input type="number" form="quick-edit-<%= p.id %>" name="quantity" value="<%= p.quantity %>" min="0" style="font-size: 12px; padding: 4px 8px; width: 65px;">
                                </td>
                                <td>
                                    <select form="quick-edit-<%= p.id %>" name="approved" style="font-size: 11px; padding: 4px;">
                                        <option value="1" <%= p.approved === 1 ? 'selected' : '' %>>Active</option>
                                        <option value="0" <%= p.approved === 0 ? 'selected' : '' %>>Disabled</option>
                                    </select>
                                </td>
                                <td>
                                    <form id="quick-edit-<%= p.id %>" method="POST" action="admin_dashboard.php/quick-product">
                                        <input type="hidden" name="product_id" value="<%= p.id %>">
                                        <button type="submit" class="btn-sm-action">Save</button>
                                    </form>
                                </td>
                                <td>
                                    <form method="POST" action="admin_dashboard.php" onsubmit="return confirm('Are you sure you want to delete this listing?');">
                                        <input type="hidden" name="product_id" value="<%= p.id %>">
                                        <button type="submit" name="delete_product" value="1" style="background: #f1f5f9; color: #dc2626; border: 1px solid #fee2e2; padding: 4px 8px; border-radius: 4px; font-size: 11px; cursor: pointer;">Delete</button>
                                    </form>
                                </td>
                            </tr>
                        <% }); %>
                    </tbody>
                </table>
            </div>
        </div>
    </section>
    <% } %>

    <!-- 4. CUSTOMER INSIGHTS TAB -->
    <% if (activeTab === 'customers') { %>
    <section class="admin-section-block">
        <!-- New vs Returning Breakdown -->
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 16px; margin-bottom: 24px;">
            <div class="metric-card">
                <div class="metric-label">New First-Time Buyers</div>
                <div class="metric-val" style="color: #2563eb;"><%= stats.customerInsights.newBuyers %></div>
                <div class="metric-sub">Single order placed</div>
            </div>
            <div class="metric-card">
                <div class="metric-label">Repeat / Returning Buyers</div>
                <div class="metric-val" style="color: #16a34a;"><%= stats.customerInsights.returningBuyers %></div>
                <div class="metric-sub text-green">High retention customers</div>
            </div>
            <div class="metric-card">
                <div class="metric-label">Open Support Tickets</div>
                <div class="metric-val" style="color: #ea580c;"><%= stats.customerInsights.openTicketsCount %></div>
                <div class="metric-sub">Pending customer resolution</div>
            </div>
        </div>

        <div style="display: grid; grid-template-columns: 1.2fr 1fr; gap: 24px;">
            <!-- Support Tickets Queue -->
            <div class="admin-card">
                <h3 class="admin-card-title">🎧 Customer Support Tickets</h3>
                <% if (stats.customerInsights.supportTickets.length === 0) { %>
                    <p style="color: #64748b; font-size: 13px;">No tickets currently on file.</p>
                <% } else { %>
                    <div style="display: flex; flex-direction: column; gap: 14px;">
                        <% stats.customerInsights.supportTickets.forEach(function(t) { %>
                            <div style="background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 10px; padding: 14px;">
                                <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 6px;">
                                    <div>
                                        <strong style="font-size: 14px;"><%= t.subject %></strong>
                                        <div style="font-size: 11px; color: #64748b;">From: <%= t.user_name %> (<%= t.user_email %>)</div>
                                    </div>
                                    <span class="badge-tag" style="background: <%= t.status === 'Resolved' ? '#dcfce7' : '#fef3c7' %>; color: <%= t.status === 'Resolved' ? '#166534' : '#92400e' %>;">
                                        <%= t.status %>
                                    </span>
                                </div>
                                <p style="font-size: 13px; color: #334155; margin: 0 0 10px;"><%= t.message %></p>
                                
                                <% if (t.admin_reply) { %>
                                    <div style="background: white; border-left: 3px solid #6366f1; padding: 8px; border-radius: 4px; font-size: 12px; margin-bottom: 10px;">
                                        <strong>Past Reply:</strong> <%= t.admin_reply %>
                                    </div>
                                <% } %>

                                <!-- Reply Form -->
                                <form method="POST" action="admin_dashboard.php/reply-ticket" style="display: flex; gap: 8px;">
                                    <input type="hidden" name="ticket_id" value="<%= t.id %>">
                                    <input type="text" name="reply" placeholder="Type resolution or reply to customer..." style="flex: 1; padding: 6px 10px; font-size: 12px; border-radius: 6px; border: 1px solid #cbd5e1;" required>
                                    <button type="submit" class="btn-primary" style="padding: 6px 12px; font-size: 12px;">Reply & Resolve</button>
                                </form>
                            </div>
                        <% }); %>
                    </div>
                <% } %>
            </div>

            <!-- Top Buyers Leaderboard -->
            <div class="admin-card">
                <h3 class="admin-card-title">🏆 Top Buyers by Cumulative Spend</h3>
                <% if (stats.customerInsights.topBuyers.length === 0) { %>
                    <p style="color: #64748b; font-size: 13px;">No buyer spend data yet.</p>
                <% } else { %>
                    <div style="display: flex; flex-direction: column; gap: 10px;">
                        <% stats.customerInsights.topBuyers.forEach(function(b, idx) { %>
                            <div style="display: flex; justify-content: space-between; align-items: center; background: #f8fafc; padding: 12px; border-radius: 8px; border: 1px solid #e2e8f0;">
                                <div style="display: flex; align-items: center; gap: 10px;">
                                    <div class="conv-avatar" style="width: 32px; height: 32px; font-size: 13px;">
                                        #<%= idx + 1 %>
                                    </div>
                                    <div>
                                        <strong style="font-size: 13px;"><%= b.userName %></strong>
                                        <div style="font-size: 11px; color: #64748b;"><%= b.orderCount %> order(s) placed</div>
                                    </div>
                                </div>
                                <div style="text-align: right;">
                                    <div style="font-weight: 700; color: #ff5e62; font-size: 13px;">
                                        UGX <%= Number(b.totalSpent).toLocaleString() %>
                                    </div>
                                    <% if (b.whatsapp) { %>
                                        <a href="https://wa.me/<%= db.sanitizeWhatsAppNumber(b.whatsapp) %>" target="_blank" style="color: #16a34a; font-size: 11px; font-weight: 600;">
                                            💬 WhatsApp
                                        </a>
                                    <% } %>
                                </div>
                            </div>
                        <% }); %>
                    </div>
                <% } %>
            </div>
        </div>
    </section>
    <% } %>

    <!-- 5. MARKETING AND PROMOTIONS TAB -->
    <% if (activeTab === 'marketing') { %>
    <section class="admin-section-block">
        <div style="display: grid; grid-template-columns: 1.2fr 1fr; gap: 24px;">
            <!-- Active Campaigns -->
            <div class="admin-card">
                <h3 class="admin-card-title">📢 Active Marketing Campaigns & Promo Codes</h3>
                <div class="table-responsive">
                    <table class="admin-table">
                        <thead>
                            <tr>
                                <th>Campaign Name</th>
                                <th>Promo Code</th>
                                <th>Discount</th>
                                <th>Clicks</th>
                                <th>Orders</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% stats.marketing.campaigns.forEach(function(c) { %>
                                <tr>
                                    <td><strong><%= c.name %></strong></td>
                                    <td><code><%= c.code %></code></td>
                                    <td><%= c.discount_percent %>% OFF</td>
                                    <td><%= c.clicks %></td>
                                    <td><strong><%= c.conversions %></strong></td>
                                    <td><span class="badge-tag" style="background: #dcfce7; color: #166534;"><%= c.status %></span></td>
                                </tr>
                            <% }); %>
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Traffic Sources Breakdown -->
            <div class="admin-card">
                <h3 class="admin-card-title">🌐 Acquisition & Traffic Sources</h3>
                <div style="flex-direction: column; display: flex; gap: 16px; margin-top: 10px;">
                    <% stats.marketing.trafficSources.forEach(function(ts) { %>
                        <div>
                            <div style="display: flex; justify-content: space-between; font-size: 13px; margin-bottom: 4px;">
                                <span><%= ts.source %></span>
                                <strong><%= ts.percentage %>%</strong>
                            </div>
                            <div style="background: #e2e8f0; height: 8px; border-radius: 4px; overflow: hidden;">
                                <div style="background: <%= ts.color %>; width: <%= ts.percentage %>%; height: 100%;"></div>
                            </div>
                        </div>
                    <% }); %>
                </div>
            </div>
        </div>
    </section>
    <% } %>
</main>
</body>
</html>
