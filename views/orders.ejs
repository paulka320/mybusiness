<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My Orders & Purchase History | EasyMarket Uganda</title>
    <link rel="stylesheet" href="style.css">
    <script src="script.js" defer></script>
</head>
<body>
<%- include('header') %>
<main class="section orders-section" style="max-width: 980px; margin: 0 auto; padding: 20px 16px;">
    <div class="section-heading orders-page-header">
        <div>
            <h2 style="margin: 0 0 4px; font-size: 1.5rem; font-weight: 800; color: #0f172a;">📦 My Orders & Purchase History</h2>
            <p style="margin: 0; font-size: 13.5px; color: #64748b;">Track real-time fulfillment status, courier dispatch, and 100% money-back returns.</p>
        </div>
        <div class="orders-header-actions">
            <a href="https://wa.me/256763480495?text=<%= encodeURIComponent('Hello EasyMarket Support, I need assistance with my orders.') %>" target="_blank" rel="noopener noreferrer" class="btn-whatsapp-sm" style="padding: 8px 14px; font-size: 12.5px; text-decoration: none; display: inline-flex; align-items: center; gap: 6px;">
                💬 WhatsApp Dispatch
            </a>
            <a href="index.php" class="btn-primary" style="padding: 8px 16px; font-size: 12.5px; text-decoration: none;">
                🛍️ Continue Shopping
            </a>
        </div>
    </div>

    <!-- Orders Metric Summary Bar -->
    <% 
        const allOrders = orders || [];
        const pendingCount = allOrders.filter(o => o.status === 'Pending' || o.status === 'Processing').length;
        const deliveredCount = allOrders.filter(o => o.status === 'Delivered').length;
        const totalSpent = allOrders.reduce((sum, o) => sum + (Number(o.total) || 0), 0);
    %>
    <div class="orders-stats-grid">
        <div class="orders-stat-card">
            <span class="orders-stat-label">Total Orders</span>
            <span class="orders-stat-value"><%= allOrders.length %></span>
            <span class="orders-stat-sub">Lifetime purchases</span>
        </div>
        <div class="orders-stat-card">
            <span class="orders-stat-label">Active In-Transit</span>
            <span class="orders-stat-value" style="color: #ea580c;"><%= pendingCount %></span>
            <span class="orders-stat-sub" style="color: #ea580c; font-weight: 600;">Dispatching</span>
        </div>
        <div class="orders-stat-card">
            <span class="orders-stat-label">Delivered Orders</span>
            <span class="orders-stat-value" style="color: #16a34a;"><%= deliveredCount %></span>
            <span class="orders-stat-sub" style="color: #16a34a; font-weight: 600;">Completed</span>
        </div>
        <div class="orders-stat-card">
            <span class="orders-stat-label">Total Order Value</span>
            <span class="orders-stat-value" style="color: #ff5e62;">UGX <%= Number(totalSpent).toLocaleString() %></span>
            <span class="orders-stat-sub">UGX currency</span>
        </div>
    </div>

    <!-- Order Category Tabs -->
    <div class="category-list orders-category-tabs" id="order-filter-tabs">
        <button type="button" class="category-pill active" onclick="filterOrders('all', this)">📋 All Orders (<%= allOrders.length %>)</button>
        <button type="button" class="category-pill" onclick="filterOrders('Pending', this)">⏳ In Fulfillment (<%= pendingCount %>)</button>
        <button type="button" class="category-pill" onclick="filterOrders('Delivered', this)">✅ Delivered (<%= deliveredCount %>)</button>
        <button type="button" class="category-pill" onclick="filterOrders('Cancelled', this)">❌ Cancelled / Returned</button>
    </div>

    <% if (orders && orders.length > 0) { %>
        <div id="orders-list-container" style="display: flex; flex-direction: column; gap: 18px;">
            <% orders.forEach(function(order) { %>
                <section class="order-card" id="order-card-<%= order.id %>" data-status="<%= order.status %>">
                    <div class="order-card-header">
                        <div class="order-header-info">
                            <div class="order-header-title-row">
                                <h3 style="margin: 0; font-size: 1.1rem; font-weight: 800; color: #0f172a;">Order #<%= order.id %></h3>
                                <span class="badge-tag" style="
                                    background: <%= order.status === 'Delivered' ? '#dcfce7' : (order.status === 'Cancelled' ? '#fee2e2' : '#fef3c7') %>;
                                    color: <%= order.status === 'Delivered' ? '#166534' : (order.status === 'Cancelled' ? '#991b1b' : '#92400e') %>;
                                    font-weight: 700; padding: 3px 10px; border-radius: 9999px; font-size: 12px; white-space: nowrap;">
                                    <%= order.status === 'Delivered' ? '✅ Delivered' : (order.status === 'Cancelled' ? '❌ Cancelled' : '⏳ In Fulfillment') %>
                                </span>
                            </div>
                            <p style="margin: 4px 0 0; color: #64748b; font-size: 12px;">
                                📅 <%= new Date(order.created_at).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' }) %>
                            </p>
                        </div>
                        <div class="order-header-price">
                            <span class="order-total" style="font-size: 1.2rem; font-weight: 800; color: #ff5e62;">UGX <%= Number(order.total).toLocaleString() %></span>
                        </div>
                    </div>

                    <div class="order-delivery-grid">
                        <div class="order-delivery-item"><strong>📍 Delivery Location:</strong> <span><%= order.address %></span></div>
                        <div class="order-delivery-item"><strong>📞 Contact Phone:</strong> <span><%= order.phone %></span></div>
                        <% if (order.payment_reference) { %>
                            <div class="order-delivery-item"><strong>💳 Payment Ref:</strong> <code style="background: #f1f5f9; padding: 2px 6px; border-radius: 4px; font-size: 11.5px;"><%= order.payment_reference %></code></div>
                        <% } %>
                    </div>

                    <div class="order-items-list">
                        <% (order.items || []).forEach(function(item) { %>
                            <% var itemPic = item.image && (item.image.startsWith('http') || item.image.startsWith('data:') || item.image.startsWith('/')) ? item.image : ('/uploads/' + (item.image || 'phone-front.svg')); %>
                            <div class="order-item-row">
                                <img src="<%= itemPic %>" onerror="this.onerror=null;this.src='/phone-front.svg';" alt="<%= item.title %>" class="order-item-thumb">
                                <div class="order-item-details">
                                    <h4 style="margin: 0 0 4px; font-size: 13.5px; font-weight: 700; color: #1e293b;"><%= item.title %></h4>
                                    <p style="margin: 0; font-size: 12px; color: #64748b;">
                                        Qty: <strong style="color: #1e293b;"><%= item.quantity %></strong> · Unit Price: <span style="color: #ff5e62; font-weight: 700;">UGX <%= Number(item.price).toLocaleString() %></span>
                                    </p>
                                </div>
                                <a href="messages.php?product_id=<%= item.product_id %>" class="btn-secondary order-item-chat-btn">
                                    💬 Chat Seller
                                </a>
                            </div>
                        <% }); %>
                    </div>

                    <!-- Order Action Bar (Returns, Refund, WhatsApp Help) -->
                    <div class="order-actions-bar">
                        <div class="order-actions-left">
                            <a href="https://wa.me/256763480495?text=<%= encodeURIComponent(`Hello EasyMarket Dispatch, I am inquiring about my Order #${order.id} status.`) %>" target="_blank" rel="noopener noreferrer" class="btn-whatsapp-sm" style="padding: 6px 12px; font-size: 12px; text-decoration: none;">
                                💬 Track on WhatsApp
                            </a>
                        </div>

                        <!-- Return / Refund Request Button & Collapse -->
                        <% if (order.status !== 'Cancelled') { %>
                            <div class="order-refund-wrapper">
                                <details style="font-size: 12.5px; color: #475569;">
                                    <summary style="cursor: pointer; color: #e11d48; font-weight: 600; padding: 4px 6px;">
                                        🔄 Request Return / Refund
                                    </summary>
                                    <form method="POST" action="returns.php" class="order-refund-form" style="margin-top: 10px; background: white; padding: 14px; border-radius: 8px; border: 1px solid #fed7aa;">
                                        <input type="hidden" name="order_id" value="<%= order.id %>">
                                        <input type="hidden" name="amount" value="<%= order.total %>">
                                        <label style="font-weight: 600; font-size: 12px; color: #1e293b; display: block; margin-bottom: 4px;">Reason for Return / Refund Claim:</label>
                                        <textarea name="reason" rows="2" placeholder="e.g. Item defective, not matching description, or wrong item received..." style="width: 100%; padding: 8px; font-size: 12px; border-radius: 6px; border: 1px solid #cbd5e1; box-sizing: border-box;" required></textarea>
                                        <button type="submit" class="btn-primary" style="background: #e11d48; margin-top: 8px; font-size: 12px; padding: 8px 14px; width: 100%;">
                                            Submit Refund Claim (UGX <%= Number(order.total).toLocaleString() %>)
                                        </button>
                                    </form>
                                </details>
                            </div>
                        <% } %>
                    </div>
                </section>
            <% }); %>
        </div>
    <% } else { %>
        <div class="empty-state" style="background: white; border: 1px solid #e2e8f0; border-radius: 12px; padding: 40px 20px; text-align: center;">
            <span style="font-size: 44px; display: block; margin-bottom: 12px;">🛍️</span>
            <h3 style="margin: 0 0 8px; font-size: 1.2rem; color: #1e293b;">No orders placed yet</h3>
            <p style="color: #64748b; font-size: 13.5px; max-width: 420px; margin: 0 auto 20px;">
                You haven't placed any orders yet. Explore thousands of verified deals from top sellers in Kampala, Entebbe, and across Uganda.
            </p>
            <div style="display: flex; gap: 10px; justify-content: center; flex-wrap: wrap;">
                <a href="index.php" class="btn-primary" style="padding: 9px 18px; font-size: 13px; text-decoration: none;">Browse Hot Deals</a>
                <a href="upload.php" class="btn-secondary" style="padding: 9px 18px; font-size: 13px; text-decoration: none;">➕ Sell a Product</a>
            </div>
        </div>
    <% } %>
</main>

<script>
function filterOrders(status, btn) {
    document.querySelectorAll('#order-filter-tabs .category-pill').forEach(el => el.classList.remove('active'));
    if (btn) btn.classList.add('active');

    const cards = document.querySelectorAll('#orders-list-container .order-card');
    cards.forEach(card => {
        const cardStatus = card.dataset.status;
        if (status === 'all') {
            card.style.display = 'block';
        } else if (status === 'Pending' && (cardStatus === 'Pending' || cardStatus === 'Processing')) {
            card.style.display = 'block';
        } else if (cardStatus === status) {
            card.style.display = 'block';
        } else {
            card.style.display = 'none';
        }
    });
}
</script>
</body>
</html>
