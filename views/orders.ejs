<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My Orders | EasyMarket</title>
    <link rel="stylesheet" href="style.css">
</head>
<body>
<%- include('header') %>
<main class="section orders-section">
    <div class="section-heading">
        <h2>My Orders</h2>
        <p>Review your recent purchases and order details.</p>
    </div>

    <% if (orders && orders.length > 0) { %>
        <% orders.forEach(function(order) { %>
            <section class="order-card">
                <div class="order-card-header">
                    <div>
                        <h3>Order #<%= order.id %></h3>
                        <p>Status: <%= order.status %></p>
                    </div>
                    <div>
                        <span class="order-total">UGX <%= Number(order.total).toLocaleString() %></span>
                        <p><%= new Date(order.created_at).toLocaleDateString('en-US', { month: 'short', day: '2-digit', year: 'numeric', hour: '2-digit', minute: '2-digit' }) %></p>
                    </div>
                </div>
                <div class="order-delivery">
                    <p><strong>Delivery address:</strong> <%= order.address %></p>
                    <p><strong>Phone:</strong> <%= order.phone %></p>
                    <% if (order.payment_reference) { %><p><strong>Payment ref:</strong> <%= order.payment_reference %></p><% } %>
                </div>
                <div class="order-items">
                    <% (order.items || []).forEach(function(item) { %>
                        <div class="order-item">
                            <img src="uploads/<%= item.image %>" alt="<%= item.title %>">
                            <div>
                                <h4><%= item.title %></h4>
                                <p>Quantity: <%= item.quantity %></p>
                                <p>Price: UGX <%= Number(item.price).toLocaleString() %></p>
                            </div>
                        </div>
                    <% }); %>
                </div>
            </section>
        <% }); %>
    <% } else { %>
        <div class="empty-state">
            <h3>No orders found yet.</h3>
            <p>Place an order from the marketplace and it will appear here.</p>
        </div>
    <% } %>
</main>
</body>
</html>
