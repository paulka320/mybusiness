<header class="site-header">
    <div class="top-bar">
        <a class="logo" href="index.php" id="site-logo">
            <span class="logo-accent">Easy</span><span>Market</span>
            <span class="logo-country-tag">UG</span>
        </a>

        <!-- Mobile Quick Bar & Toggle -->
        <div class="header-right-actions">
            <a href="cart.php" class="header-cart-icon-btn" aria-label="Shopping Cart">
                🛒 <span class="nav-counter" id="cart-count-mobile">0</span>
            </a>
            <button type="button" id="mobile-menu-toggle" class="mobile-menu-btn" aria-label="Toggle navigation menu" aria-expanded="false">
                <span class="hamburger-bar"></span>
                <span class="hamburger-bar"></span>
                <span class="hamburger-bar"></span>
            </button>
        </div>

        <% 
            const cp = (locals.currentPath || '').toLowerCase();
            const isHome = cp === '' || cp === '/' || cp === '/index' || cp.includes('index') || cp.includes('category');
            const isUpload = cp.includes('upload');
            const isCart = cp.includes('cart');
            const isMessages = cp.includes('messages');
            const isAlerts = cp.includes('notifications') || cp.includes('alerts');
            const isOrders = cp.includes('orders');
            const isSupport = cp.includes('support');
            const isAdmin = cp.includes('admin_dashboard') || cp.includes('admin');
            const isLogin = cp.includes('login') && !cp.includes('admin');
            const isRegister = cp.includes('register') && !cp.includes('admin');
        %>

        <nav class="main-nav" id="site-main-nav">
            <a href="/index.php" id="nav-home" class="<%= isHome ? 'active' : '' %>">
                <span>🏠 Home</span>
            </a>
            <a href="/upload.php" id="nav-sell" class="nav-sell-btn <%= isUpload ? 'active' : '' %>">
                <span>➕ Sell Product</span>
            </a>
            <a href="/cart.php" id="nav-cart" class="nav-cart-desktop <%= isCart ? 'active' : '' %>">
                <span>🛒 Cart</span>
                <span id="cart-count" class="nav-counter">0</span>
            </a>
            
            <% if (locals.user && locals.user.id) { %>
                <a href="/my_products.php" id="nav-my-products" class="<%= cp.includes('my_products') ? 'active' : '' %>" title="Manage your listings, prices and inventory">
                    <span>📋 My Listings</span>
                </a>

                <a href="/messages.php" id="nav-messages" class="nav-badge-link <%= isMessages ? 'active' : '' %>" title="Direct In-App Messages">
                    <span>💬 Messages</span>
                    <% if (locals.unreadMsgsCount > 0) { %>
                        <span class="nav-counter"><%= locals.unreadMsgsCount %></span>
                    <% } %>
                </a>

                <a href="/notifications.php" id="nav-notifs" class="nav-badge-link <%= isAlerts ? 'active' : '' %>" title="Notifications & Marketplace Rules">
                    <span>🔔 Alerts</span>
                    <% if (locals.unreadNotifsCount > 0) { %>
                        <span class="nav-counter notif-dot" id="notifs-counter"><%= locals.unreadNotifsCount %></span>
                    <% } %>
                </a>

                <a href="/orders.php" id="nav-orders" class="<%= isOrders ? 'active' : '' %>">
                    <span>📦 My Orders</span>
                </a>
                <a href="/support.php" id="nav-support" class="<%= isSupport ? 'active' : '' %>">
                    <span>🎧 Support</span>
                </a>

                <% if (locals.user.is_admin == 1) { %>
                    <a href="/admin_dashboard.php" id="nav-admin" class="nav-admin-badge <%= isAdmin ? 'active' : '' %>">⚡ Admin Suite</a>
                <% } %>

                <div class="nav-user-cluster">
                    <span class="nav-user-greeting">👤 <%= locals.user.name %></span>
                    <a href="/logout.php" id="nav-logout-btn" class="nav-logout-btn">🚪 Logout</a>
                </div>
            <% } else { %>
                <a href="/support.php" id="nav-support" class="<%= isSupport ? 'active' : '' %>">
                    <span>🎧 Help Center</span>
                </a>
                <a href="/login.php" id="nav-login" class="<%= isLogin ? 'active' : '' %>">
                    <span>🔑 Login</span>
                </a>
                <a href="/register.php" id="nav-register" class="nav-register-btn <%= isRegister ? 'active' : '' %>">
                    <span>✨ Register</span>
                </a>
                <a href="/admin_login.php" id="nav-admin-login" class="nav-admin-portal <%= isAdmin ? 'active' : '' %>">⚡ Admin</a>
            <% } %>
        </nav>
    </div>
</header>

<script>
window.EASY_MARKET_USER = {
    id: <%= (locals.user && locals.user.id) ? JSON.stringify(locals.user.id) : 'null' %>,
    name: <%= (locals.user && locals.user.name) ? JSON.stringify(locals.user.name) : '""' %>,
    phone: <%= (locals.user && (locals.user.whatsapp_number || locals.user.phone)) ? JSON.stringify(locals.user.whatsapp_number || locals.user.phone) : '""' %>,
    whatsapp_number: <%= (locals.user && (locals.user.whatsapp_number || locals.user.phone)) ? JSON.stringify(locals.user.whatsapp_number || locals.user.phone) : '""' %>
};
window.SYSTEM_WHATSAPP_NUMBER = '256763480495';
if (window.EASY_MARKET_USER.whatsapp_number) {
    try {
        localStorage.setItem('user_whatsapp', window.EASY_MARKET_USER.whatsapp_number);
        if (window.EASY_MARKET_USER.name) localStorage.setItem('user_name', window.EASY_MARKET_USER.name);
    } catch(e) {}
}
</script>
