<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login | EasyMarket</title>
    <link rel="stylesheet" href="style.css">
</head>
<body>
<%- include('header') %>
<main class="section upload-section">
    <div class="section-heading">
        <h2>Login to EasyMarket</h2>
        <p>Access your orders and checkout faster.</p>
    </div>

    <% if (locals.errors && errors.length > 0) { %>
        <div class="alert alert-error">
            <ul>
                <% errors.forEach(function(error) { %>
                    <li><%= error %></li>
                <% }); %>
            </ul>
        </div>
    <% } %>

    <form class="product-form" method="POST" action="login.php">
        <input type="hidden" name="return" value="<%= locals.returnTo || locals.returnUrl || '' %>">
        <label for="login-email">Email or Username</label>
        <input type="text" id="login-email" name="email" placeholder="you@example.com" value="<%= locals.email || '' %>" required autocomplete="username">

        <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 10px;">
            <label for="login-password" style="margin: 0;">Password</label>
            <a href="forgot_password.php" style="font-size: 12px; color: #2563eb; font-weight: 600; text-decoration: none;">Forgot Password? (Get OTP)</a>
        </div>
        <input type="password" id="login-password" name="password" required autocomplete="current-password">

        <button type="submit" id="user-login-submit">Login</button>
    </form>

    <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 18px; font-size: 13px;">
        <p style="margin: 0;">Don't have an account? <a href="register.php" style="font-weight: 700; color: #2563eb;">Register here</a>.</p>
        <a href="forgot_password.php" style="color: #64748b; text-decoration: none;">🔐 Reset with Email OTP</a>
    </div>
</main>
</body>
</html>
