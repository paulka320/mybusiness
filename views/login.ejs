<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login | EasyMarket</title>
    <link rel="stylesheet" href="style.css">
</head>
<body>
<%- include('header') %>
<main class="section upload-section">
    <div class="section-heading">
        <h2>Login to EasyMarket</h2>
        <p>Access your orders and checkout faster.</p>
    </div>

    <% if (locals.errors && errors.length > 0) { %>
        <div class="alert alert-error">
            <ul>
                <% errors.forEach(function(error) { %>
                    <li><%= error %></li>
                <% }); %>
            </ul>
        </div>
    <% } %>

    <form class="product-form" method="POST" action="login.php">
        <input type="hidden" name="return" value="<%= returnUrl %>">
        <label>Email</label>
        <input type="email" name="email" placeholder="you@example.com" value="<%= locals.email || '' %>" required>

        <label>Password</label>
        <input type="password" name="password" required>

        <button type="submit">Login</button>
    </form>

    <p>Don't have an account? <a href="register.php">Register here</a>.</p>
</main>
</body>
</html>
