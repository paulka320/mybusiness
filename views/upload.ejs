<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sell on EasyMarket Uganda | Verified Product Listing</title>
    <link rel="stylesheet" href="style.css">
    <script src="script.js" defer></script>
</head>
<body>
<%- include('header') %>
<main class="section upload-section">
    <div class="section-heading">
        <div>
            <h2>List a Product on EasyMarket</h2>
            <p>Reach verified buyers across Uganda with 5-angle verified photos and WhatsApp direct contact.</p>
        </div>
    </div>

    <% if (locals.success) { %>
        <div class="alert alert-success" id="upload-success-msg"><%= success %></div>
    <% } %>

    <% if (locals.errors && errors.length > 0) { %>
        <div class="alert alert-error" id="upload-error-box">
            <ul>
                <% errors.forEach(function(error) { %>
                    <li><%= error %></li>
                <% }); %>
            </ul>
        </div>
    <% } %>

    <form class="product-form" method="POST" enctype="multipart/form-data" action="/upload" id="product-upload-form">
        <label for="prod-title">Product Title</label>
        <input type="text" id="prod-title" name="title" value="<%= locals.formData ? (formData.title || '') : '' %>" placeholder="e.g. iPhone 13 Pro 128GB Graphite or Men's Leather Jacket" required>

        <label for="prod-desc">Description</label>
        <textarea id="prod-desc" name="description" rows="5" placeholder="Detailed product specifications, condition, battery health, accessories included..." required><%= locals.formData ? (formData.description || '') : '' %></textarea>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px;">
            <div>
                <label for="prod-price">Price (UGX)</label>
                <input type="number" id="prod-price" step="100" name="price" value="<%= locals.formData ? (formData.price || '') : '' %>" placeholder="e.g. 250000" required>
            </div>
            <div>
                <label for="prod-qty">Available Stock Quantity</label>
                <input type="number" id="prod-qty" name="quantity" min="0" value="<%= locals.formData ? (formData.quantity || '') : '1' %>" placeholder="Stock units" required>
            </div>
        </div>

        <label for="prod-cat">Category</label>
        <select id="prod-cat" name="category" required>
            <option value="">Select Category</option>
            <% categories.forEach(function(c) { %>
                <option value="<%= c.id %>" <%= (locals.formData && formData.category == c.id) ? 'selected' : '' %>><%= c.name %></option>
            <% }); %>
        </select>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px;">
            <div>
                <label for="prod-phone">Contact Phone</label>
                <input type="tel" id="prod-phone" name="phone" value="<%= locals.formData ? (formData.phone || '') : (locals.user ? (locals.user.phone || locals.user.whatsapp_number || '') : '') %>" placeholder="+256 701 234567" required>
            </div>
            <div>
                <label for="prod-wa">WhatsApp Number (For Direct Buyer Chats)</label>
                <input type="tel" id="prod-wa" name="whatsapp_number" value="<%= locals.formData ? (formData.whatsapp_number || '') : (locals.user ? (locals.user.whatsapp_number || locals.user.phone || '') : '') %>" placeholder="e.g. 0701234567 or 256701234567">
            </div>
        </div>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px;">
            <div>
                <label for="prod-loc">Location</label>
                <input type="text" id="prod-loc" name="location" value="<%= locals.formData ? (formData.location || '') : '' %>" placeholder="e.g. Kampala, Nakawa, Jinja" required>
            </div>
            <div>
                <label for="prod-pay">Payment Code / Mobile Money Ref</label>
                <input type="text" id="prod-pay" name="payment" value="<%= locals.formData ? (formData.payment || '') : '' %>" placeholder="e.g. MTN-88231 or Airtel Merchant">
            </div>
        </div>

        <!-- 5-Angle Verified Photos & Batch Multi-Image Upload -->
        <div style="background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 12px; padding: 20px; margin: 20px 0;">
            <div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 10px; margin-bottom: 12px;">
                <div style="display: flex; align-items: center; gap: 8px;">
                    <span style="font-size: 20px;">📸</span>
                    <strong style="color: #0f172a; font-size: 16px;">Product Photos & Multi-Angle Verification</strong>
                </div>
                <span style="font-size: 12px; background: #e0f2fe; color: #0369a1; padding: 4px 10px; border-radius: 9999px; font-weight: 600;">
                    🛡️ 5-Angle Authenticity Verified
                </span>
            </div>
            
            <p style="font-size: 13px; color: #64748b; margin: 0 0 16px; line-height: 1.5;">
                Upload real photos of your product. You can upload each angle individually or select multiple photos at once. Front view is required.
            </p>

            <!-- Angle Slots with Live Preview -->
            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 14px; margin-bottom: 16px;">
                <div class="photo-upload-slot" id="slot-front" style="border: 2px dashed #cbd5e1; border-radius: 10px; padding: 12px; background: #ffffff; text-align: center;">
                    <label style="font-size: 12px; font-weight: 700; color: #0f172a; display: block; margin-bottom: 6px;">1. Front View (Required) *</label>
                    <div class="preview-box" id="preview-box-front" style="height: 110px; display: flex; align-items: center; justify-content: center; background: #f1f5f9; border-radius: 8px; margin-bottom: 8px; overflow: hidden;">
                        <span style="font-size: 28px; opacity: 0.5;">📷</span>
                    </div>
                    <input type="file" name="front_image" id="input-front-image" accept="image/*" required style="font-size: 11px; width: 100%;" onchange="previewUploadImage(this, 'preview-box-front')">
                </div>

                <div class="photo-upload-slot" id="slot-back" style="border: 2px dashed #cbd5e1; border-radius: 10px; padding: 12px; background: #ffffff; text-align: center;">
                    <label style="font-size: 12px; font-weight: 600; color: #475569; display: block; margin-bottom: 6px;">2. Back View (Optional)</label>
                    <div class="preview-box" id="preview-box-back" style="height: 110px; display: flex; align-items: center; justify-content: center; background: #f1f5f9; border-radius: 8px; margin-bottom: 8px; overflow: hidden;">
                        <span style="font-size: 28px; opacity: 0.5;">🔄</span>
                    </div>
                    <input type="file" name="back_image" id="input-back-image" accept="image/*" style="font-size: 11px; width: 100%;" onchange="previewUploadImage(this, 'preview-box-back')">
                </div>

                <div class="photo-upload-slot" id="slot-left" style="border: 2px dashed #cbd5e1; border-radius: 10px; padding: 12px; background: #ffffff; text-align: center;">
                    <label style="font-size: 12px; font-weight: 600; color: #475569; display: block; margin-bottom: 6px;">3. Left Side (Optional)</label>
                    <div class="preview-box" id="preview-box-left" style="height: 110px; display: flex; align-items: center; justify-content: center; background: #f1f5f9; border-radius: 8px; margin-bottom: 8px; overflow: hidden;">
                        <span style="font-size: 28px; opacity: 0.5;">⬅️</span>
                    </div>
                    <input type="file" name="left_image" id="input-left-image" accept="image/*" style="font-size: 11px; width: 100%;" onchange="previewUploadImage(this, 'preview-box-left')">
                </div>

                <div class="photo-upload-slot" id="slot-right" style="border: 2px dashed #cbd5e1; border-radius: 10px; padding: 12px; background: #ffffff; text-align: center;">
                    <label style="font-size: 12px; font-weight: 600; color: #475569; display: block; margin-bottom: 6px;">4. Right Side (Optional)</label>
                    <div class="preview-box" id="preview-box-right" style="height: 110px; display: flex; align-items: center; justify-content: center; background: #f1f5f9; border-radius: 8px; margin-bottom: 8px; overflow: hidden;">
                        <span style="font-size: 28px; opacity: 0.5;">➡️</span>
                    </div>
                    <input type="file" name="right_image" id="input-right-image" accept="image/*" style="font-size: 11px; width: 100%;" onchange="previewUploadImage(this, 'preview-box-right')">
                </div>

                <div class="photo-upload-slot" id="slot-top" style="border: 2px dashed #cbd5e1; border-radius: 10px; padding: 12px; background: #ffffff; text-align: center;">
                    <label style="font-size: 12px; font-weight: 600; color: #475569; display: block; margin-bottom: 6px;">5. Top/Detail View (Optional)</label>
                    <div class="preview-box" id="preview-box-top" style="height: 110px; display: flex; align-items: center; justify-content: center; background: #f1f5f9; border-radius: 8px; margin-bottom: 8px; overflow: hidden;">
                        <span style="font-size: 28px; opacity: 0.5;">🔍</span>
                    </div>
                    <input type="file" name="top_image" id="input-top-image" accept="image/*" style="font-size: 11px; width: 100%;" onchange="previewUploadImage(this, 'preview-box-top')">
                </div>
            </div>

            <!-- Multi-Select Batch Upload Option -->
            <div style="background: #f1f5f9; border: 1px solid #cbd5e1; border-radius: 8px; padding: 12px; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 10px;">
                <div>
                    <strong style="font-size: 12px; color: #1e293b;">⚡ Or Select Multiple Photos at Once:</strong>
                    <div style="font-size: 11px; color: #64748b;">Pick up to 5 additional gallery photos directly from your camera roll / files.</div>
                </div>
                <input type="file" name="photos" id="input-multi-photos" accept="image/*" multiple style="font-size: 12px;" onchange="previewMultiUploadPhotos(this)">
            </div>
            <div id="batch-preview-container" style="display: flex; gap: 8px; flex-wrap: wrap; margin-top: 10px;"></div>
        </div>

        <script>
        function previewUploadImage(input, previewBoxId) {
            const box = document.getElementById(previewBoxId);
            if (!box) return;
            if (input.files && input.files[0]) {
                const reader = new FileReader();
                reader.onload = function(e) {
                    box.innerHTML = `<img src="${e.target.result}" style="width: 100%; height: 100%; object-fit: cover; border-radius: 6px;" alt="Preview">`;
                    const slot = box.closest('.photo-upload-slot');
                    if (slot) {
                        slot.style.borderColor = '#16a34a';
                        slot.style.backgroundColor = '#f0fdf4';
                    }
                };
                reader.readAsDataURL(input.files[0]);
            }
        }

        function previewMultiUploadPhotos(input) {
            const container = document.getElementById('batch-preview-container');
            if (!container) return;
            container.innerHTML = '';
            if (input.files) {
                Array.from(input.files).forEach(file => {
                    const reader = new FileReader();
                    reader.onload = function(e) {
                        const thumb = document.createElement('div');
                        thumb.style.width = '60px';
                        thumb.style.height = '60px';
                        thumb.style.borderRadius = '6px';
                        thumb.style.overflow = 'hidden';
                        thumb.style.border = '2px solid #16a34a';
                        thumb.style.flexShrink = '0';
                        thumb.innerHTML = `<img src="${e.target.result}" style="width: 100%; height: 100%; object-fit: cover;">`;
                        container.appendChild(thumb);
                    };
                    reader.readAsDataURL(file);
                });
            }
        }
        </script>

        <button type="submit" id="btn-upload-submit" class="btn-primary" style="width: 100%; padding: 14px; font-size: 15px;">
            Publish Verified Product Listing
        </button>
    </form>
</main>
</body>
</html>
