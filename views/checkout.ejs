<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Checkout | EasyMarket</title>
    <link rel="stylesheet" href="style.css">
    <script src="script.js" defer></script>
</head>
<body>
<%- include('header') %>
<main class="section upload-section">
    <div class="section-heading">
        <h2>Checkout</h2>
        <p>Confirm your order details and place your purchase.</p>
    </div>

    <% if (locals.success) { %>
        <div class="alert alert-success" style="font-size: 15px; padding: 18px; border-radius: 12px; margin-bottom: 20px;">
            <div style="font-weight: 700; font-size: 16px; margin-bottom: 6px;">🎉 Order Placed Successfully!</div>
            <%= success %>
        </div>
        <script>window.orderPlaced = true;</script>
        
        <% if (locals.orderId) { %>
            <div style="background: #f0fdf4; border: 1px solid #86efac; border-radius: 14px; padding: 22px; margin-bottom: 24px; text-align: center;">
                <span style="font-size: 36px; display: block; margin-bottom: 8px;">📱</span>
                <h3 style="margin: 0 0 6px; font-size: 1.2rem; color: #166534; font-weight: 800;">Fast-Track Dispatch on WhatsApp (0763480495)</h3>
                <p style="color: #15803d; font-size: 13.5px; max-width: 540px; margin: 0 auto 16px; line-height: 1.5;">
                    Send an instant confirmation from your WhatsApp to our official business WhatsApp line <strong>0763480495</strong> (+256 763 480495) so our Kampala courier team can begin immediate packaging and dispatch.
                </p>
                <%
                    const ordBuyerName = locals.user ? locals.user.name : 'Customer';
                    const ordBuyerPhone = locals.buyerPhone || (locals.user ? (locals.user.whatsapp_number || locals.user.phone) : '');
                    const ordWaText = `Hello EasyMarket Dispatch! I just placed Order #${locals.orderId} on EasyMarket Uganda.\n\n• Name: ${ordBuyerName}\n• WhatsApp / Phone: ${ordBuyerPhone || 'Registered Account'}\n• Delivery Address: ${locals.orderAddress || 'Uganda'}\n• Order Total: UGX ${Number(locals.orderTotal || 0).toLocaleString()}\n\nPlease confirm my order dispatch schedule.`;
                    const ordWaUrl = `https://wa.me/256763480495?text=${encodeURIComponent(ordWaText)}`;
                %>
                <a href="<%= ordWaUrl %>" target="_blank" rel="noopener noreferrer" class="btn-whatsapp" style="display: inline-flex; align-items: center; justify-content: center; gap: 8px; padding: 13px 26px; font-size: 14.5px; font-weight: 700; text-decoration: none; border-radius: 10px;">
                    <span>💬 Chat on WhatsApp to Confirm Dispatch (0763480495)</span>
                </a>
            </div>
        <% } %>

        <div style="display: flex; gap: 12px; justify-content: center; flex-wrap: wrap; margin-top: 10px;">
            <a href="orders.php" class="btn-primary" style="padding: 10px 20px; text-decoration: none;">📦 View in My Orders</a>
            <a href="index.php" class="btn-secondary" style="padding: 10px 20px; text-decoration: none;">🛍️ Continue Shopping</a>
        </div>
    <% } else { %>
        <% if (locals.errors && errors.length > 0) { %>
            <div class="alert alert-error">
                <ul>
                    <% errors.forEach(function(error) { %>
                        <li><%= error %></li>
                    <% }); %>
                </ul>
            </div>
        <% } %>

        <div id="checkout-items" class="cart-items"></div>

        <form id="checkout-form" class="product-form" method="POST" action="checkout.php">
            <input type="hidden" id="cart_data" name="cart_data" value="">

            <label>Delivery Address</label>
            <textarea name="address" required><%= locals.address || '' %></textarea>

            <label>Phone Number</label>
            <input type="text" name="phone" value="<%= locals.phone || '' %>" required>

            <label>Payment Reference</label>
            <input type="text" name="payment_reference" value="<%= locals.payment_reference || '' %>" placeholder="Enter payment reference or mobile money code">

            <button id="checkout-submit" type="submit">Place Order</button>
        </form>
    <% } %>
</main>
</body>
</html>
