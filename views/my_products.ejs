<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My Published Listings & Prices | EasyMarket Uganda</title>
    <link rel="stylesheet" href="style.css">
    <script src="script.js" defer></script>
</head>
<body>
<%- include('header') %>

<main class="section main-container" style="max-width: 1200px; margin: 24px auto; padding: 0 16px;">
    
    <!-- Page Header & Summary -->
    <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 16px; margin-bottom: 24px; border-bottom: 1px solid #e2e8f0; padding-bottom: 16px;">
        <div>
            <h1 style="margin: 0; font-size: 1.75rem; font-weight: 800; color: #0f172a; display: flex; align-items: center; gap: 10px;">
                📋 My Published Products & Pricing
            </h1>
            <p style="margin: 6px 0 0; color: #64748b; font-size: 14px;">
                Manage your product listings, update prices, manage stock, and review admin pricing proposals.
            </p>
        </div>
        <a href="upload.php" class="btn-primary" style="padding: 10px 20px; font-size: 14px; text-decoration: none; border-radius: 10px; display: inline-flex; align-items: center; gap: 8px;">
            ➕ Publish New Product
        </a>
    </div>

    <!-- Flash Feedback Alert -->
    <% if (locals.feedback) { %>
        <div style="padding: 14px 18px; border-radius: 12px; margin-bottom: 24px; font-size: 14px; font-weight: 600; <%= feedback.type === 'error' ? 'background: #fef2f2; border: 1px solid #fca5a5; color: #991b1b;' : 'background: #f0fdf4; border: 1px solid #86efac; color: #166534;' %>">
            <%= feedback.message %>
        </div>
    <% } %>

    <!-- PENDING ADMIN PRICE PROPOSALS SECTION (IF ANY) -->
    <% if (pendingRequests && pendingRequests.length > 0) { %>
        <section style="background: #fffbeb; border: 2px solid #fcd34d; border-radius: 16px; padding: 22px; margin-bottom: 28px; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05);">
            <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 16px;">
                <h2 style="margin: 0; font-size: 1.2rem; font-weight: 800; color: #92400e; display: flex; align-items: center; gap: 8px;">
                    ⚠️ Price Change Proposals from Admin Awaiting Your Approval (<%= pendingRequests.length %>)
                </h2>
                <span style="font-size: 12px; font-weight: 700; background: #fef3c7; color: #b45309; padding: 4px 10px; border-radius: 20px; border: 1px solid #fde68a;">
                    Requires Seller Acceptance
                </span>
            </div>
            <p style="margin: 0 0 16px; font-size: 13px; color: #78350f;">
                Per EasyMarket marketplace rules, the Admin cannot change your prices directly without your consent. Please review the proposed price changes below and choose to <strong>Accept</strong> or <strong>Decline</strong>.
            </p>

            <div style="display: flex; flex-direction: column; gap: 14px;">
                <% pendingRequests.forEach(function(req) { %>
                    <% var reqImg = req.product_image && (req.product_image.startsWith('http') || req.product_image.startsWith('/') || req.product_image.startsWith('data:')) ? req.product_image : ('/uploads/' + (req.product_image || 'phone-front.svg')); %>
                    <div style="background: #ffffff; border: 1px solid #fde68a; border-radius: 12px; padding: 16px; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 16px;">
                        <div style="display: flex; align-items: center; gap: 14px;">
                            <img src="<%= reqImg %>" onerror="this.onerror=null;this.src='/phone-front.svg';" alt="" style="width: 54px; height: 54px; object-fit: cover; border-radius: 8px; border: 1px solid #e2e8f0;">
                            <div>
                                <a href="product.php?id=<%= req.product_id %>" target="_blank" style="font-weight: 700; font-size: 15px; color: #0f172a; text-decoration: none;">
                                    <%= req.product_title %>
                                </a>
                                <div style="margin-top: 4px; font-size: 13px; color: #475569;">
                                    Current Price: <span style="font-weight: 700; color: #64748b; text-decoration: line-through;">UGX <%= Number(req.current_price).toLocaleString() %></span> 
                                    ➔ <strong style="color: #16a34a; font-size: 14px;">Proposed: UGX <%= Number(req.proposed_price).toLocaleString() %></strong>
                                </div>
                                <% if (req.reason) { %>
                                    <div style="margin-top: 2px; font-size: 12px; color: #b45309;">
                                        <em>Admin Note: <%= req.reason %></em>
                                    </div>
                                <% } %>
                            </div>
                        </div>

                        <div style="display: flex; gap: 10px; align-items: center;">
                            <!-- Accept Form -->
                            <form method="POST" action="/seller/price-request/respond" style="margin: 0;">
                                <input type="hidden" name="request_id" value="<%= req.id %>">
                                <input type="hidden" name="decision" value="Accepted">
                                <button type="submit" style="background: #16a34a; color: white; border: none; padding: 8px 16px; border-radius: 8px; font-weight: 700; font-size: 13px; cursor: pointer; display: flex; align-items: center; gap: 6px;">
                                    ✅ Accept New Price
                                </button>
                            </form>

                            <!-- Reject Form -->
                            <form method="POST" action="/seller/price-request/respond" style="margin: 0;">
                                <input type="hidden" name="request_id" value="<%= req.id %>">
                                <input type="hidden" name="decision" value="Rejected">
                                <button type="submit" style="background: #f1f5f9; color: #475569; border: 1px solid #cbd5e1; padding: 8px 14px; border-radius: 8px; font-weight: 700; font-size: 13px; cursor: pointer;">
                                    ❌ Decline
                                </button>
                            </form>
                        </div>
                    </div>
                <% }); %>
            </div>
        </section>
    <% } %>

    <!-- MY PUBLISHED PRODUCTS LISTING -->
    <section class="admin-card" style="background: #ffffff; border: 1px solid #e2e8f0; border-radius: 16px; padding: 24px; box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; flex-wrap: wrap; gap: 12px;">
            <div>
                <h2 style="margin: 0; font-size: 1.25rem; font-weight: 800; color: #0f172a;">
                    📦 Products Published by You (<%= products.length %>)
                </h2>
                <p style="margin: 4px 0 0; font-size: 13px; color: #64748b;">
                    You are the publisher and owner. You can freely change your price and inventory stock anytime.
                </p>
            </div>
        </div>

        <% if (!products || products.length === 0) { %>
            <div style="text-align: center; padding: 48px 16px; color: #64748b;">
                <div style="font-size: 40px; margin-bottom: 12px;">🏷️</div>
                <h3 style="margin: 0 0 8px; color: #1e293b; font-size: 1.2rem;">You haven't published any products yet</h3>
                <p style="margin: 0 0 20px; font-size: 14px;">Start selling across Uganda today by uploading your first product with verified photos.</p>
                <a href="upload.php" class="btn-primary" style="padding: 10px 24px; text-decoration: none; border-radius: 8px; display: inline-block;">
                    ➕ Upload Your First Product
                </a>
            </div>
        <% } else { %>
            <div class="table-responsive">
                <table class="admin-table" style="width: 100%; border-collapse: collapse;">
                    <thead>
                        <tr style="background: #f8fafc; border-bottom: 2px solid #e2e8f0; text-align: left;">
                            <th style="padding: 12px; font-size: 12px; font-weight: 700; color: #475569;">Photo</th>
                            <th style="padding: 12px; font-size: 12px; font-weight: 700; color: #475569;">Product Title & Details</th>
                            <th style="padding: 12px; font-size: 12px; font-weight: 700; color: #475569;">Status</th>
                            <th style="padding: 12px; font-size: 12px; font-weight: 700; color: #475569;">Your Price (UGX)</th>
                            <th style="padding: 12px; font-size: 12px; font-weight: 700; color: #475569;">Available Stock</th>
                            <th style="padding: 12px; font-size: 12px; font-weight: 700; color: #475569; text-align: center;">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% products.forEach(function(p) { %>
                            <% 
                                var isSoldOut = (p.quantity <= 0);
                                var pImg = p.image && (p.image.startsWith('http') || p.image.startsWith('/') || p.image.startsWith('data:')) ? p.image : ('/uploads/' + (p.image || 'phone-front.svg'));
                            %>
                            <tr style="border-bottom: 1px solid #f1f5f9; <%= isSoldOut ? 'background: #fffafa;' : '' %>">
                                <td style="padding: 12px;">
                                    <a href="product.php?id=<%= p.id %>" target="_blank">
                                        <img src="<%= pImg %>" onerror="this.onerror=null;this.src='/phone-front.svg';" alt="<%= p.title %>" style="width: 52px; height: 52px; object-fit: cover; border-radius: 8px; border: 1px solid #e2e8f0;">
                                    </a>
                                </td>

                                <td style="padding: 12px;">
                                    <a href="product.php?id=<%= p.id %>" target="_blank" style="font-weight: 700; font-size: 14px; color: #0f172a; text-decoration: none;">
                                        <%= p.title %>
                                    </a>
                                    <div style="font-size: 11px; color: #64748b; margin-top: 3px;">
                                        ID: #<%= p.id %> · <span class="badge-tag" style="padding: 1px 6px; font-size: 10px;"><%= p.category_name || 'General' %></span> · 📍 <%= p.location %>
                                    </div>
                                </td>

                                <td style="padding: 12px;">
                                    <% if (isSoldOut) { %>
                                        <span style="background: #fee2e2; color: #dc2626; border: 1px solid #fca5a5; font-size: 11px; font-weight: 700; padding: 3px 8px; border-radius: 12px; display: inline-block;">
                                            🔴 Sold Out (0 left)
                                        </span>
                                    <% } else { %>
                                        <span style="background: #dcfce7; color: #15803d; border: 1px solid #86efac; font-size: 11px; font-weight: 700; padding: 3px 8px; border-radius: 12px; display: inline-block;">
                                            🟢 Available (<%= p.quantity %> units)
                                        </span>
                                    <% } %>
                                </td>

                                <!-- Inline Price & Stock Edit Form -->
                                <td style="padding: 12px;">
                                    <form id="seller-edit-<%= p.id %>" method="POST" action="/seller/update-price">
                                        <input type="hidden" name="product_id" value="<%= p.id %>">
                                        <input type="number" name="price" value="<%= p.price %>" step="100" min="100" required style="font-size: 13px; font-weight: 700; padding: 6px 10px; width: 120px; border-radius: 6px; border: 1px solid #cbd5e1; color: #0f172a;">
                                    </form>
                                </td>

                                <td style="padding: 12px;">
                                    <input type="number" form="seller-edit-<%= p.id %>" name="quantity" value="<%= p.quantity %>" min="0" required style="font-size: 13px; font-weight: 700; padding: 6px 10px; width: 70px; border-radius: 6px; border: 1px solid #cbd5e1; color: <%= isSoldOut ? '#dc2626' : '#0f172a' %>;">
                                </td>

                                <td style="padding: 12px; text-align: center;">
                                    <div style="display: flex; gap: 6px; justify-content: center;">
                                        <button type="submit" form="seller-edit-<%= p.id %>" style="background: #2563eb; color: white; border: none; padding: 6px 14px; border-radius: 6px; font-size: 12px; font-weight: 700; cursor: pointer; display: flex; align-items: center; gap: 4px;">
                                            💾 Save Price
                                        </button>
                                        <a href="product.php?id=<%= p.id %>" target="_blank" style="background: #f1f5f9; color: #475569; border: 1px solid #cbd5e1; padding: 6px 10px; border-radius: 6px; font-size: 12px; font-weight: 600; text-decoration: none;">
                                            👁️ View
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        <% }); %>
                    </tbody>
                </table>
            </div>
        <% } %>
    </section>

</main>

</body>
</html>
