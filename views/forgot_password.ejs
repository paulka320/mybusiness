<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Forgot Password | EasyMarket Uganda</title>
    <link rel="stylesheet" href="style.css">
    <script src="script.js" defer></script>
</head>
<body>
<%- include('header') %>

<main class="section upload-section" style="max-width: 520px; margin: 40px auto;">
    <div class="section-heading" style="text-align: center; margin-bottom: 24px;">
        <div style="font-size: 44px; margin-bottom: 10px;">🔐</div>
        <h2>Forgot Password?</h2>
        <p>Enter your registered email to receive a secure 6-digit One-Time Password (OTP) code.</p>
    </div>

    <% if (locals.errors && errors.length > 0) { %>
        <div class="alert alert-error" style="margin-bottom: 18px;">
            <ul style="margin: 0; padding-left: 20px;">
                <% errors.forEach(function(error) { %>
                    <li><%= error %></li>
                <% }); %>
            </ul>
        </div>
    <% } %>

    <% if (locals.success) { %>
        <div class="alert alert-success" style="margin-bottom: 18px;">
            <%= success %>
        </div>
    <% } %>

    <div style="background: white; border: 1px solid #e2e8f0; border-radius: 16px; padding: 28px; box-shadow: 0 10px 25px -5px rgba(0,0,0,0.05);">
        <form class="product-form" method="POST" action="forgot_password.php" style="display: flex; flex-direction: column; gap: 16px;">
            <div>
                <label for="recovery-email" style="font-weight: 700; font-size: 13px; color: #1e293b; display: block; margin-bottom: 6px;">
                    Registered Email Address
                </label>
                <input 
                    type="email" 
                    id="recovery-email" 
                    name="email" 
                    placeholder="e.g. yourname@gmail.com" 
                    value="<%= locals.email || '' %>" 
                    required 
                    autocomplete="email"
                    style="width: 100%; padding: 12px 14px; border: 1.5px solid #cbd5e1; border-radius: 8px; font-size: 14px;"
                >
                <span style="font-size: 11.5px; color: #64748b; margin-top: 4px; display: block;">
                    🛡️ System will check email authenticity and Google mail validation before dispatching OTP.
                </span>
            </div>

            <button type="submit" class="btn-primary" id="btn-request-otp" style="width: 100%; padding: 12px; font-size: 15px; font-weight: 700; border-radius: 8px; cursor: pointer;">
                📧 Send 6-Digit OTP Code
            </button>
        </form>

        <div style="margin-top: 20px; padding-top: 16px; border-top: 1px solid #f1f5f9; text-align: center; font-size: 13px; color: #64748b;">
            Remembered your password? <a href="login.php" style="color: #2563eb; font-weight: 700; text-decoration: none;">Back to Login</a>
        </div>
    </div>
</main>
</body>
</html>
