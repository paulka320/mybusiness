<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Verify OTP & Reset Password | EasyMarket Uganda</title>
    <link rel="stylesheet" href="style.css">
    <script src="script.js" defer></script>
</head>
<body>
<%- include('header') %>

<main class="section upload-section" style="max-width: 520px; margin: 40px auto;">
    <div class="section-heading" style="text-align: center; margin-bottom: 20px;">
        <div style="font-size: 44px; margin-bottom: 10px;">🔑</div>
        <h2>Enter Verification Code</h2>
        <p>A 6-digit One-Time Password (OTP) was generated for <strong><%= locals.email %></strong>.</p>
    </div>

    <!-- Helpful OTP notice / simulator preview for seamless verification in dev/cloud -->
    <% if (locals.previewOtp) { %>
        <div style="background: #eff6ff; border: 1.5px dashed #3b82f6; border-radius: 12px; padding: 14px 18px; margin-bottom: 20px; text-align: center;">
            <div style="font-size: 12px; font-weight: 700; color: #1e40af; text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 4px;">
                📨 One-Time Password (OTP) Dispatched
            </div>
            <div style="font-size: 26px; font-weight: 900; letter-spacing: 6px; color: #1d4ed8; font-family: monospace; margin: 6px 0;">
                <%= previewOtp %>
            </div>
            <div style="font-size: 11.5px; color: #3b82f6;">
                Valid for 15 minutes. Check your registered inbox or use the code above to proceed.
            </div>
        </div>
    <% } %>

    <% if (locals.errors && errors.length > 0) { %>
        <div class="alert alert-error" style="margin-bottom: 18px;">
            <ul style="margin: 0; padding-left: 20px;">
                <% errors.forEach(function(error) { %>
                    <li><%= error %></li>
                <% }); %>
            </ul>
        </div>
    <% } %>

    <div style="background: white; border: 1px solid #e2e8f0; border-radius: 16px; padding: 28px; box-shadow: 0 10px 25px -5px rgba(0,0,0,0.05);">
        <form class="product-form" method="POST" action="reset_password.php" style="display: flex; flex-direction: column; gap: 16px;">
            <input type="hidden" name="email" value="<%= locals.email %>">

            <div>
                <label for="otp-code" style="font-weight: 700; font-size: 13px; color: #1e293b; display: block; margin-bottom: 6px;">
                    6-Digit One-Time Password (OTP)
                </label>
                <input 
                    type="text" 
                    id="otp-code" 
                    name="otp" 
                    placeholder="Enter 6-digit code (e.g. 849201)" 
                    value="<%= locals.otp || '' %>" 
                    maxlength="6"
                    pattern="[0-9]{6}"
                    required 
                    autocomplete="one-time-code"
                    style="width: 100%; padding: 12px 14px; border: 1.5px solid #cbd5e1; border-radius: 8px; font-size: 18px; font-weight: 800; letter-spacing: 4px; text-align: center;"
                >
            </div>

            <div>
                <label for="new-password" style="font-weight: 700; font-size: 13px; color: #1e293b; display: block; margin-bottom: 6px;">
                    New Password
                </label>
                <input 
                    type="password" 
                    id="new-password" 
                    name="password" 
                    placeholder="At least 6 characters" 
                    minlength="6" 
                    required 
                    autocomplete="new-password"
                    style="width: 100%; padding: 12px 14px; border: 1.5px solid #cbd5e1; border-radius: 8px; font-size: 14px;"
                >
            </div>

            <div>
                <label for="confirm-password" style="font-weight: 700; font-size: 13px; color: #1e293b; display: block; margin-bottom: 6px;">
                    Confirm New Password
                </label>
                <input 
                    type="password" 
                    id="confirm-password" 
                    name="confirm_password" 
                    placeholder="Re-type new password" 
                    minlength="6" 
                    required 
                    autocomplete="new-password"
                    style="width: 100%; padding: 12px 14px; border: 1.5px solid #cbd5e1; border-radius: 8px; font-size: 14px;"
                >
            </div>

            <button type="submit" class="btn-primary" id="btn-submit-reset" style="width: 100%; padding: 12px; font-size: 15px; font-weight: 700; border-radius: 8px; cursor: pointer;">
                🔒 Update Password & Login
            </button>
        </form>

        <div style="display: flex; justify-content: space-between; margin-top: 20px; padding-top: 16px; border-top: 1px solid #f1f5f9; font-size: 12.5px;">
            <a href="forgot_password.php" style="color: #64748b; text-decoration: none;">← Request new code</a>
            <a href="login.php" style="color: #2563eb; font-weight: 700; text-decoration: none;">Cancel & Login</a>
        </div>
    </div>
</main>
</body>
</html>
