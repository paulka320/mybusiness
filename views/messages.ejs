<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>In-App Direct Messages | EasyMarket Uganda</title>
    <link rel="stylesheet" href="style.css">
    <script src="script.js" defer></script>
</head>
<body>
<%- include('header') %>
<main class="section" style="max-width: 1100px;">
    <div class="section-heading">
        <div>
            <h2>💬 Buyer & Seller Direct Messaging</h2>
            <p>Chat directly on EasyMarket with instant delivery updates and 1-click WhatsApp sync.</p>
        </div>
        <div style="display: flex; gap: 8px;">
            <a href="messages.php?to=1" class="btn-secondary" style="font-size: 13px; padding: 8px 14px; text-decoration: none;">
                🎧 Chat Support Desk
            </a>
            <%
                const msgUsrName = locals.user ? locals.user.name : 'Customer';
                const msgUsrWa = locals.user ? (locals.user.whatsapp_number || locals.user.phone || '') : '';
                const msgHeaderWaText = `Hello EasyMarket Official WhatsApp (0763480495)! I am ${msgUsrName}${msgUsrWa ? ` (messaging from my registered WhatsApp: ${msgUsrWa})` : ''}. I have an inquiry regarding marketplace listings and orders.`;
                const msgHeaderWaUrl = `https://wa.me/256763480495?text=${encodeURIComponent(msgHeaderWaText)}`;
            %>
            <a href="<%= msgHeaderWaUrl %>" target="_blank" rel="noopener noreferrer" class="btn-whatsapp-sm" style="padding: 8px 14px; font-size: 13px; text-decoration: none;">
                💬 Official WhatsApp (0763480495)
            </a>
        </div>
    </div>

    <div class="chat-app-layout">
        <!-- Conversations Sidebar -->
        <aside class="chat-sidebar">
            <div class="chat-sidebar-header">
                <h3 style="margin: 0; font-size: 15px;">Conversations</h3>
            </div>
            
            <div class="chat-conversations-list">
                <!-- Pinned EasyMarket Support Thread -->
                <a href="messages.php?to=1" class="conversation-item <%= (locals.counterparty && locals.counterparty.id == 1) ? 'active' : '' %>" style="border-bottom: 2px solid #e2e8f0; background: <%= (locals.counterparty && locals.counterparty.id == 1) ? '#eff6ff' : '#f8fafc' %>;">
                    <div class="conv-avatar" style="background: #2563eb; color: #ffffff;">
                        🛡️
                    </div>
                    <div class="conv-info">
                        <div class="conv-top">
                            <strong style="color: #1e40af;">EasyMarket Support</strong>
                            <span class="unread-pill" style="background: #2563eb;">24/7 Desk</span>
                        </div>
                        <div class="conv-last-msg">
                            Official assistance & order help
                        </div>
                    </div>
                </a>

                <% if (!conversations || conversations.length === 0) { %>
                    <div style="padding: 24px 16px; text-align: center; color: #64748b; font-size: 13px;">
                        <p style="margin: 0 0 8px;">No other buyer or seller chats yet.</p>
                        <a href="index.php" style="color: #ff5e62; font-weight: 700; font-size: 12px; text-decoration: none;">Browse items to contact sellers</a>
                    </div>
                <% } else { %>
                    <% conversations.filter(c => c.counterpartyId != 1).forEach(function(c) { %>
                        <a href="messages.php?to=<%= c.counterpartyId %>" class="conversation-item <%= (locals.counterparty && locals.counterparty.id == c.counterpartyId) ? 'active' : '' %>">
                            <div class="conv-avatar">
                                <%= (c.counterpartyName || 'U').charAt(0).toUpperCase() %>
                            </div>
                            <div class="conv-info">
                                <div class="conv-top">
                                    <strong><%= c.counterpartyName %></strong>
                                    <% if (c.unreadCount > 0) { %>
                                        <span class="unread-pill"><%= c.unreadCount %></span>
                                    <% } %>
                                </div>
                                <div class="conv-last-msg">
                                    <%= c.lastMessage %>
                                </div>
                            </div>
                        </a>
                    <% }); %>
                <% } %>
            </div>
        </aside>

        <!-- Active Chat Window -->
        <section class="chat-main-window <%= locals.counterparty ? 'has-active-chat' : '' %>">
            <% if (locals.counterparty) { %>
                <!-- Chat Header with WhatsApp Bridge -->
                <div class="chat-window-header" style="flex-wrap: wrap; gap: 12px;">
                    <div style="display: flex; align-items: center; gap: 10px;">
                        <a href="messages.php" class="mobile-back-to-chats-btn" aria-label="Back to conversations list">
                            ← All Chats
                        </a>
                        <div class="chat-user-meta" style="display: flex; align-items: center; gap: 10px;">
                            <div class="conv-avatar" style="width: 38px; height: 38px; font-size: 15px;">
                                <%= (counterparty.name || 'U').charAt(0).toUpperCase() %>
                            </div>
                            <div>
                                <div style="display: flex; align-items: center; gap: 6px;">
                                    <h3 style="margin: 0; font-size: 15px; font-weight: 700;"><%= counterparty.name %></h3>
                                    <% if (counterparty.is_admin === 1) { %>
                                        <span style="background: #eff6ff; color: #2563eb; font-size: 10px; font-weight: 700; padding: 2px 6px; border-radius: 4px;">Admin</span>
                                    <% } %>
                                </div>
                                <span style="font-size: 12px; color: #16a34a; font-weight: 600;">● Active on EasyMarket</span>
                            </div>
                        </div>
                    </div>

                    <!-- Counterparty Verified Details & WhatsApp Button -->
                    <div style="display: flex; align-items: center; gap: 8px; flex-wrap: wrap;">
                        <% if (counterparty.email || counterparty.phone) { %>
                            <div style="font-size: 11.5px; color: #64748b; background: #f8fafc; border: 1px solid #e2e8f0; padding: 4px 10px; border-radius: 6px;">
                                <% if (counterparty.email) { %><span>✉️ <%= counterparty.email %></span><% } %>
                                <% if (counterparty.phone) { %><span style="margin-left: 6px;">📞 <%= counterparty.phone %></span><% } %>
                            </div>
                        <% } %>

                        <% 
                            const isSupportChat = (!counterparty.id || counterparty.id === 2 || (counterparty.name && counterparty.name.toLowerCase().includes('support')) || (counterparty.name && counterparty.name.toLowerCase().includes('admin')));
                            const targetWaNum = isSupportChat ? '256763480495' : db.sanitizeWhatsAppNumber(counterparty.whatsapp_number || counterparty.phone || '256763480495');
                            const customerName = locals.user ? user.name : 'Customer';
                            const itemName = locals.activeProduct ? ` regarding "${activeProduct.title}" (Item #${activeProduct.id})` : '';
                            const waText = `Hello ${counterparty.name || 'there'}! I am messaging you${itemName} on EasyMarket Uganda.`;
                            const waUrl = `https://wa.me/${targetWaNum}?text=${encodeURIComponent(waText)}`;
                        %>
                        <a href="<%= waUrl %>" target="_blank" rel="noopener noreferrer" class="btn-whatsapp-sm" style="display: inline-flex; align-items: center; gap: 5px; text-decoration: none;">
                            <span>💬 Open in WhatsApp</span>
                        </a>
                    </div>
                </div>

                <!-- Product Reference Card if chatting about an item -->
                <% if (locals.activeProduct) { %>
                    <% var itemImg = activeProduct.image && (activeProduct.image.startsWith('http') || activeProduct.image.startsWith('data:') || activeProduct.image.startsWith('/')) ? activeProduct.image : ('/uploads/' + (activeProduct.image || 'phone-front.svg')); %>
                    <div class="chat-product-banner">
                        <img src="<%= itemImg %>" onerror="this.onerror=null;this.src='/phone-front.svg';" alt="<%= activeProduct.title %>">
                        <div>
                            <strong><%= activeProduct.title %></strong>
                            <div style="color: #ff5e62; font-weight: 700; font-size: 13px;">
                                UGX <%= Number(activeProduct.price).toLocaleString() %>
                            </div>
                        </div>
                        <a href="product.php?id=<%= activeProduct.id %>" class="btn-view-listing">View Listing</a>
                    </div>
                <% } %>

                <!-- Messages Stream -->
                <div class="chat-messages-container" id="chat-messages-container">
                    <% if (!activeMessages || activeMessages.length === 0) { %>
                        <div class="empty-chat-prompt" style="text-align: center; padding: 40px 20px;">
                            <span style="font-size: 40px;">👋</span>
                            <h4 style="margin: 10px 0 4px;">Start conversation with <%= counterparty.name %></h4>
                            <p style="color: #64748b; font-size: 13px; max-width: 380px; margin: 0 auto 16px;">
                                Use the suggested quick messages below or type your questions regarding price, location, or dispatch.
                            </p>
                            <!-- Quick Prompts -->
                            <div style="display: flex; gap: 8px; justify-content: center; flex-wrap: wrap;">
                                <button type="button" class="btn-quick-prompt" onclick="setChatMessage('Hello! Is this product still available in stock?')">📦 Is this available?</button>
                                <button type="button" class="btn-quick-prompt" onclick="setChatMessage('Can you arrange delivery to my location today?')">🚚 Delivery inquiry</button>
                                <button type="button" class="btn-quick-prompt" onclick="setChatMessage('What is your best final price for this item?')">🏷️ Best price?</button>
                            </div>
                        </div>
                    <% } else { %>
                        <% activeMessages.forEach(function(msg) { %>
                            <div class="message-row <%= msg.sender_id === userId ? 'message-outgoing' : 'message-incoming' %>">
                                <div class="message-bubble">
                                    <p class="message-text" style="margin: 0;"><%= msg.message %></p>
                                    <span class="message-timestamp">
                                        <%= new Date(msg.created_at).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }) %>
                                    </span>
                                </div>
                            </div>
                        <% }); %>
                    <% } %>
                </div>

                <!-- Message Input Composer -->
                <form class="chat-composer-form" method="POST" action="messages.php" id="chat-composer">
                    <input type="hidden" name="receiver_id" value="<%= counterparty.id %>">
                    <% if (locals.activeProduct) { %>
                        <input type="hidden" name="product_id" value="<%= activeProduct.id %>">
                    <% } %>
                    <input type="text" name="message" id="chat-input-text" placeholder="Type your message to <%= counterparty.name %>..." autocomplete="off" required>
                    <button type="submit" class="btn-send-msg" id="btn-send-msg">Send 🚀</button>
                </form>
            <% } else { %>
                <div class="empty-chat-prompt" style="margin: auto; text-align: center; padding: 48px 24px; max-width: 460px;">
                    <span style="font-size: 52px; display: block; margin-bottom: 14px;">💬</span>
                    <h3 style="margin: 0 0 8px; font-size: 1.25rem;">EasyMarket Messaging Hub</h3>
                    <p style="color: #64748b; font-size: 13.5px; line-height: 1.6; margin: 0 0 20px;">
                        Communicate safely with verified buyers and sellers in Uganda. Messages are backed by 24/7 fraud monitoring and seamless WhatsApp continuation.
                    </p>
                    <div style="display: flex; gap: 10px; justify-content: center; flex-wrap: wrap;">
                        <a href="messages.php?to=1" class="btn-primary" style="font-size: 13px; text-decoration: none;">
                            🛡️ Message EasyMarket Support
                        </a>
                        <a href="index.php" class="btn-secondary" style="font-size: 13px; text-decoration: none;">
                            🛍️ Browse Products
                        </a>
                    </div>
                </div>
            <% } %>
        </section>
    </div>
</main>

<script>
function setChatMessage(text) {
    const input = document.getElementById('chat-input-text');
    if (input) {
        input.value = text;
        input.focus();
    }
}

document.addEventListener('DOMContentLoaded', () => {
    const container = document.getElementById('chat-messages-container');
    if (container) {
        container.scrollTop = container.scrollHeight;
    }
});
</script>
</body>
</html>
